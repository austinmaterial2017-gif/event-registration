lues.filter(function(item) {\n    return typeof item === 'string' && item !== value;\n  }) : [];\n  if (enabled) list.push(value);\n  return list;\n}\n\nfunction validateAdminIdentityFields_(identityFields, questions, candidate) {\n  if (!Array.isArray(identityFields)) adminError_('CONFLICT');\n  if (!identityFields.length) return;\n  var questionsById = {};\n  questions.forEach(function(question) {\n    if (question.eventId === candidate.eventId) questionsById[question.questionId] = question;\n  });\n  questionsById[candidate.questionId] = candidate;\n  var seen = {};\n  identityFields.forEach(function(questionId) {\n    if (typeof questionId !== 'string' || !questionId || seen[questionId]) {\n      adminError_('CONFLICT');\n    }\n    seen[questionId] = true;\n    var question = questionsById[questionId];\n    if (!question || String(question.status || '').toLowerCase() !== 'active' ||\n        !adminTruthy_(question.required)) {\n      adminError_('CONFLICT');\n    }\n  });\n}\n\n===== staff-apps-script/Code.gs =====\n/** The dedicated signed-in Web App has no anonymous API surface. */\nfunction doGet(event) {\n  var view = event && event.parameter && event.parameter.view;\n  if (view === 'admin') {\n    try {\n      requireAuthorizedAdminSession_();\n      return HtmlService.createTemplateFromFile('Admin')\n        .evaluate()\n        .setTitle('活动管理后台');\n    } catch (_ignored) {\n      return HtmlService\n        .createHtmlOutput('<!doctype html><html><body><main><h1>Administrator access unavailable.</h1></main></body></html>')\n        .setTitle('Administrator access unavailable');\n    }\n  }\n  try {\n    requireAuthorizedStaffSession_();\n    return HtmlService.createHtmlOutputFromFile('StaffCheckIn')\n      .setTitle('员工讲座签到');\n  } catch (_ignored) {\n    return HtmlService\n      .createHtmlOutput('<!doctype html><html><body><main><h1>Staff access unavailable.</h1></main></body></html>')\n      .setTitle('Staff access unavailable');\n  }\n}\n\n===== staff-apps-script/StaffCheckIn.html =====\n<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <base target=\"_top\">\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <style>\n      body { margin:0; padding:24px; background:#18131d; color:#f8f0df; font:15px/1.5 Arial,sans-serif; }\n      main { max-width:560px; margin:auto; } form, section { display:grid; gap:14px; padding:20px; border:1px solid #594463; border-radius:18px; background:#2b202f; }\n      label { display:grid; gap:6px; } input, select, button { min-height:44px; padding:9px 11px; border-radius:10px; font:inherit; }\n      input, select { border:1px solid #6b5874; background:#171219; color:#fff; } button { border:0; background:linear-gradient(110deg,#ff4fa3,#8755ff); color:#fff; font-weight:800; cursor:pointer; }\n      .confirm { display:flex; align-items:flex-start; gap:8px; }.confirm input { min-height:auto; margin-top:5px; }.message { min-height:1.5em; color:#77e4aa; }\n      [hidden] { display:none !important; }\n    </style>\n  </head>\n  <body>\n    <main>\n      <h1>员工讲座签到</h1>\n      <p>员工身份来自当前 Google 登录会话，页面不会接受手动填写的身份。</p>\n      <form id=\"lookup-form\">\n        <label>二维码 token 或验票网址\n          <input name=\"token\" inputmode=\"url\" autocomplete=\"off\" required>\n        </label>\n        <button type=\"submit\">读取凭证</button>\n      </form>\n      <form id=\"check-in-form\" hidden>\n        <p id=\"ticket-summary\"></p>\n        <label>签到场次\n          <select name=\"sessionId\" required>\n            <option value=\"\">请选择场次</option>\n          </select>\n        </label>\n        <label class=\"confirm\">\n          <input name=\"confirmCheckIn\" type=\"checkbox\" required>\n          我已当面核对参与者和本场讲座\n        </label>\n        <button type=\"submit\">确认本场签到</button>\n      </form>\n      <p id=\"message\" class=\"message\" role=\"status\"></p>\n    </main>\n    <script>\n      const lookupForm = document.querySelector(\"#lookup-form\");\n      const checkInForm = document.querySelector(\"#check-in-form\");\n      const message = document.querySelector(\"#message\");\n      const summary = document.querySelector(\"#ticket-summary\");\n      let activeToken = \"\";\n\n      function parseScannedTicketToken(value) {\n        const text = String(value || \"\").trim();\n        if (!text || text.length > 2048) return \"\";\n        try {\n          const parsed = new URL(text, window.location.href);\n          const queryToken = parsed.searchParams.get(\"token\");\n          if (queryToken && queryToken.trim().length <= 512) return queryToken.trim();\n        } catch (_ignored) {\n          // A camera/scanner may provide the opaque token directly.\n        }\n        return text.length <= 512 && !/\\s/.test(text) ? text : \"\";\n      }\n\n      function showResult(result) {\n        if (!result || result.ok !== true) {\n          message.textContent = result && result.message ? result.message : \"员工签到不可用。\";\n          return;\n        }\n        const ticket = result.data;\n        summary.textContent = `${ticket.participantName} · ${ticket.event.title} · ${ticket.status}`;\n        const select = checkInForm.elements.sessionId;\n        select.length = 1;\n        ticket.sessions.forEach((session) => {\n          const option = document.createElement(\"option\");\n          option.value = session.sessionId;\n          option.textContent = `${session.title} · ${session.speaker || \"讲师待公布\"}`;\n          select.append(option);\n        });\n        checkInForm.hidden = ticket.status !== \"active\";\n        message.textContent = \"已读取凭证；请选择本次签到场次。\";\n      }\n\n      function lookupTicketForCheckIn(value) {\n        activeToken = parseScannedTicketToken(value);\n        if (!activeToken) {\n          message.textContent = \"二维码或验票网址无效。\";\n          return;\n        }\n        lookupForm.elements.token.value = activeToken;\n        message.textContent = \"正在读取凭证…\";\n        google.script.run\n          .withSuccessHandler(showResult)\n          .withFailureHandler(() => { message.textContent = \"员工签到不可用。\"; })\n          .getStaffTicketForCheckIn({ token: activeToken });\n      }\n\n      lookupForm.addEventListener(\"submit\", (event) => {\n        event.preventDefault();\n        lookupTicketForCheckIn(lookupForm.elements.token.value);\n      });\n\n      checkInForm.addEventListener(\"submit\", (event) => {\n        event.preventDefault();\n        if (!checkInForm.elements.confirmCheckIn.checked) return;\n        message.textContent = \"正在提交签到…\";\n        google.script.run\n          .withSuccessHandler((result) => {\n            message.textContent = result && result.ok\n              ? \"本场签到成功。\"\n              : result && result.message ? result.message : \"签到未完成。\";\n          })\n          .withFailureHandler(() => { message.textContent = \"员工签到不可用。\"; })\n          .checkIn({ token: activeToken, sessionId: checkInForm.elements.sessionId.value });\n      });\n\n      const initialParameters = new URLSearchParams(window.location.search);\n      const initialScan = initialParameters.get(\"token\") || initialParameters.get(\"scan\") || \"\";\n      if (initialScan) lookupTicketForCheckIn(initialScan);\n    </script>\n  </body>\n</html>\n\n===== staff-apps-script/Admin.html =====\n<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <base target=\"_top\">\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <style>\n      :root {\n        --charcoal: #18131d;\n        --panel: #261d2b;\n        --panel-deep: #100d13;\n        --ivory: #f8f0df;\n        --muted: #c8b9ca;\n        --line: #594463;\n        --magenta: #ff4fa3;\n        --purple: #8755ff;\n        --green: #77e4aa;\n        --danger: #ff7f91;\n        --radius: 18px;\n      }\n      * { box-sizing: border-box; }\n      html { scroll-behavior: smooth; }\n      body {\n        margin: 0;\n        background: var(--charcoal);\n        color: var(--ivory);\n        font: 15px/1.5 \"Aptos\", \"Noto Sans SC\", \"Microsoft YaHei\", sans-serif;\n      }\n      button, input, select, textarea { font: inherit; }\n      button, a, input, select, textarea { outline: none; }\n      :focus-visible { box-shadow: 0 0 0 3px var(--charcoal), 0 0 0 6px var(--magenta); }\n      .shell { min-height: 100vh; display: grid; grid-template-columns: 250px minmax(0, 1fr); }\n      .sidebar {\n        position: sticky; top: 0; height: 100vh; padding: 28px 22px;\n        border-right: 1px solid var(--line); background: rgba(16, 13, 19, .9);\n        backdrop-filter: blur(18px);\n      }\n      .eyebrow { margin: 0; color: var(--magenta); font: 700 11px/1.2 \"Consolas\", monospace; letter-spacing: .16em; text-transform: uppercase; }\n      .brand { margin: 8px 0 6px; font: 700 29px/1.05 \"Iowan Old Style\", \"Noto Serif SC\", Georgia, serif; }\n      .sidebar-copy { margin: 0 0 24px; color: var(--muted); font-size: 13px; }\n      nav { display: grid; gap: 7px; }\n      nav a { padding: 9px 11px; border-left: 2px solid transparent; color: var(--muted); text-decoration: none; }\n      nav a:hover, nav a[aria-current=\"page\"] { color: var(--ivory); border-color: var(--magenta); background: rgba(255, 79, 163, .07); }\n      nav a[aria-current=\"page\"] { font-weight: 800; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }\n      nav a[aria-disabled=\"true\"] { opacity: .5; cursor: not-allowed; }\n      .workspace { min-width: 0; padding: 34px clamp(18px, 4vw, 54px) 64px; }\n      .masthead { display: grid; gap: 22px; margin: 0 auto 28px; max-width: 1420px; }\n      .masthead h1 { max-width: 850px; margin: 4px 0 0; font: 650 clamp(34px, 5vw, 68px)/.98 \"Iowan Old Style\", \"Noto Serif SC\", Georgia, serif; letter-spacing: -.035em; }\n      .masthead p { max-width: 760px; margin: 0; color: var(--muted); }\n      .lifecycle-rail {\n        display: grid; grid-template-columns: repeat(8, minmax(92px, 1fr)); overflow: auto;\n        border: 1px solid var(--line); border-radius: 999px; background: var(--panel-deep);\n      }\n      .lifecycle-rail span { position: relative; padding: 10px 15px; color: var(--muted); font: 700 11px/1 \"Consolas\", monospace; text-align: center; text-transform: uppercase; }\n      .lifecycle-rail span + span::before { content: \"\"; position: absolute; inset: 7px auto 7px 0; width: 1px; background: var(--line); }\n      .lifecycle-rail [data-public=\"true\"] { color: var(--ivory); }\n      .lifecycle-rail [data-live=\"true\"] { color: var(--green); }\n      .status-line { min-height: 28px; margin: 0 auto 14px; max-width: 1420px; color: var(--green); }\n      .stack { display: grid; gap: 22px; max-width: 1420px; margin: auto; }\n      .panel { scroll-margin-top: 18px; border: 1px solid var(--line); border-radius: var(--radius); background: rgba(38, 29, 43, .96); box-shadow: 0 20px 70px rgba(0, 0, 0, .18); }\n      .panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; padding: 20px 22px; border-bottom: 1px solid var(--line); }\n      .panel-head h2 { margin: 2px 0 0; font: 650 25px/1.1 \"Iowan Old Style\", \"Noto Serif SC\", Georgia, serif; }\n      .panel-head p { max-width: 640px; margin: 4px 0 0; color: var(--muted); font-size: 13px; }\n      .panel-body { display: grid; gap: 18px; padding: 22px; }\n      .split { display: grid; grid-template-columns: minmax(320px, .85fr) minmax(420px, 1.15fr); gap: 18px; }\n      form, .form-grid { display: grid; gap: 13px; }\n      .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n      .wide { grid-column: 1 / -1; }\n      label { display: grid; align-content: start; gap: 6px; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .025em; }\n      input, select, textarea {\n        width: 100%; min-height: 42px; padding: 9px 11px; border: 1px solid #6b5874;\n        border-radius: 10px; background: #171219; color: var(--ivory);\n      }\n      textarea { min-height: 86px; resize: vertical; }\n      .checks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 14px; }\n      .check { display: flex; align-items: flex-start; gap: 8px; color: var(--ivory); font-weight: 500; }\n      .check input { width: auto; min-height: auto; margin: 4px 0 0; accent-color: var(--magenta); }\n      .actions { display: flex; flex-wrap: wrap; gap: 9px; }\n      button {\n        min-height: 42px; padding: 9px 14px; border: 1px solid transparent; border-radius: 10px;\n        background: var(--magenta); color: white; font-weight: 800; cursor: pointer;\n      }\n      button.secondary, a.secondary { border-color: var(--line); background: transparent; color: var(--ivory); }\n      a.secondary { display: inline-flex; align-items: center; min-height: 42px; padding: 9px 14px; border: 1px solid var(--line); border-radius: 10px; font-weight: 800; text-decoration: none; }\n      button.danger { border-color: rgba(255, 127, 145, .55); background: rgba(255, 127, 145, .1); color: #ffd5dc; }\n      button:disabled { opacity: .45; cursor: not-allowed; }\n      .data-list { display: grid; gap: 9px; align-content: start; max-height: 540px; overflow: auto; }\n      .data-row { display: grid; gap: 6px; padding: 13px 14px; border: 1px solid rgba(89, 68, 99, .8); border-radius: 12px; background: rgba(16, 13, 19, .48); }\n      .data-row strong { color: var(--ivory); }\n      .data-row small, .empty { color: var(--muted); }\n      .pill { display: inline-flex; width: fit-content; padding: 3px 8px; border: 1px solid var(--line); border-radius: 999px; color: var(--green); font: 700 10px/1.3 \"Consolas\", monospace; text-transform: uppercase; }\n      .warning { margin: 0; padding: 13px 15px; border-left: 3px solid var(--magenta); background: rgba(255, 79, 163, .07); color: var(--ivory); }\n      .source-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\n      .source-card { display: grid; gap: 12px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel-deep); }\n      .source-card h3 { margin: 0; }\n      code { color: #e6d9ff; font-family: \"Consolas\", monospace; }\n      .activity-picker { display: grid; gap: 6px; min-width: min(100%, 330px); }\n      .activity-picker select { min-width: 0; }\n      .activity-context {\n        display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: center;\n        padding: 18px 22px; border: 1px solid var(--magenta); border-radius: var(--radius);\n        background: var(--panel-deep);\n      }\n      .activity-context h2 { margin: 4px 0 0; font: 700 clamp(22px, 3vw, 34px)/1.1 \"Microsoft YaHei\", \"Noto Sans SC\", sans-serif; }\n      .activity-context p { margin: 5px 0 0; color: var(--muted); }\n      .activity-context .pill { color: var(--ivory); border-color: var(--magenta); }\n      .empty-selection { margin: 0; padding: 16px 0; color: var(--muted); }\n      .advanced-maintenance { border: 1px solid var(--line); border-radius: var(--radius); background: rgba(38, 29, 43, .96); }\n      .advanced-maintenance > summary { padding: 16px 20px; color: var(--ivory); font: 700 12px/1.3 \"Consolas\", monospace; cursor: pointer; }\n      .advanced-maintenance > summary:focus-visible { outline: none; }\n      .advanced-maintenance .panel { border: 0; border-radius: 0; box-shadow: none; background: transparent; }\n      [hidden] { display: none !important; }\n      @media (max-width: 1050px) {\n        .shell { grid-template-columns: 1fr; }\n        .sidebar { z-index: 4; height: auto; padding: 14px 18px; border: 0; border-bottom: 1px solid var(--line); }\n        .sidebar .brand, .sidebar-copy { display: none; }\n        nav { display: flex; gap: 2px; overflow: auto; }\n        nav a { flex: 0 0 auto; border-left: 0; border-bottom: 2px solid transparent; }\n        .split { grid-template-columns: 1fr; }\n      }\n      @media (max-width: 680px) {\n        .workspace { padding-inline: 13px; }\n        .fields, .checks, .source-grid { grid-template-columns: 1fr; }\n        .panel-head, .panel-body { padding-inline: 15px; }\n        .activity-context { grid-template-columns: 1fr; padding: 16px; }\n        .masthead h1 { font-size: 38px; }\n      }\n      @media (prefers-reduced-motion: reduce) {\n        html { scroll-behavior: auto; }\n        *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }\n      }\n    </style>\n  </head>\n  <body>\n    <div class=\"shell\">\n      <aside class=\"sidebar\">\n        <p class=\"eyebrow\">Protected staff project</p>\n        <p class=\"brand\">Event control room</p>\n        <p class=\"sidebar-copy\">管理活动、场次、座位、问题与历史记录。身份来自当前 Google 登录会话。</p>\n        <nav aria-label=\"管理区导航\">\n          <a href=\"#events\">活动</a><a href=\"#sessions\">场次</a><a href=\"#seats\">座位</a>\n          <a href=\"#questions\">问题</a><a href=\"#records\">记录</a><a href=\"#attendance\">签到</a>\n        </nav>\n      </aside>\n\n      <main class=\"workspace\">\n        <header class=\"masthead\">\n          <p class=\"eyebrow\">Administrator application</p>\n          <h1>从草稿到归档，保持每一条历史记录可追溯。</h1>\n          <p>关闭活动默认设为已结束。归档只隐藏公开显示，不删除活动、报名、座位或签到记录。</p>\n          <div class=\"lifecycle-rail\" aria-label=\"活动生命周期\">\n            <span>draft</span><span data-public=\"true\">upcoming</span><span data-public=\"true\">open</span>\n            <span data-public=\"true\">closed</span><span data-live=\"true\">live</span>\n            <span data-public=\"true\">ended</span><span data-public=\"true\">cancelled</span><span>archived</span>\n          </div>\n        </header>\n        <p id=\"admin-status\" class=\"status-line\" role=\"status\" aria-live=\"polite\">正在读取管理数据…</p>\n\n        <div class=\"stack\">\n          <section id=\"events\" class=\"panel\">\n            <div class=\"panel-head\"><div><p class=\"eyebrow\">Lifecycle</p><h2>活动</h2><p>先选择或新建活动，再编辑该活动的场次、座位、问题和记录。</p></div><label class=\"activity-picker\">当前活动<select id=\"activity-selector\" aria-label=\"选择当前活动\"></select></label></div>\n            <div class=\"panel-body split\">\n              <form id=\"event-form\">\n                <input name=\"eventId\" type=\"hidden\">\n                <div class=\"fields\">\n                  <label>锁位分钟数<input name=\"seatHoldMinutes\" type=\"number\" min=\"1\" step=\"1\" value=\"5\"></label>\n                  <label class=\"check\"><input name=\"seatHoldsEnabled\" type=\"checkbox\">选座时暂时锁位</label>\n                </div>\n                <div class=\"fields\">\n                  <label class=\"wide\">活动名称<input name=\"title\" required maxlength=\"200\"></label>\n                  <label class=\"wide\">说明<textarea name=\"description\" maxlength=\"5000\"></textarea></label>\n                  <label>状态<select name=\"status\">\n                    <option value=\"draft\">草稿 draft</option><option value=\"upcoming\">即将开放 upcoming</option>\n                    <option value=\"open\">报名开放 open</option><option value=\"closed\">报名关闭 closed</option>\n                    <option value=\"live\">进行中 live</option><option value=\"ended\">已结束 ended</option>\n                    <option value=\"cancelled\">已取消 cancelled</option><option value=\"archived\">已归档 archived</option>\n                  </select></label>\n                  <label>地点<input name=\"location\" maxlength=\"300\"></label>\n                  <label>开放时间<input name=\"opensAt\" type=\"datetime-local\"></label>\n                  <label>截止时间<input name=\"closesAt\" type=\"datetime-local\"></label>\n                  <label>场次选择规则<select name=\"selectionMode\">\n                    <option value=\"none\">无需选择</option><option value=\"single\">单选</option><option value=\"all\">全部</option>\n                    <option value=\"free\">自由多选</option><option value=\"mixed\">必选＋自选</option><option value=\"multiple\">多选</option>\n                  </select></label>\n                  <label>座位模式<select name=\"seatMode\">\n                    <option value=\"none\">none 自由入座</option><option value=\"self\">self 自行选座</option>\n                    <option value=\"auto\">auto 系统分配</option><option value=\"zone\">zone 选择区域</option>\n                  </select></label>\n                  <label id=\"min-session-field\">最少场次<input name=\"minChoices\" type=\"number\" min=\"0\" step=\"1\" value=\"0\"></label>\n                  <label id=\"max-session-field\">最多场次<input name=\"maxChoices\" type=\"number\" min=\"0\" step=\"1\" value=\"0\"></label>\n                  <label id=\"seat-zone-field\" class=\"wide\">座位区域（每行一个）<textarea name=\"seatZones\"></textarea></label>\n                </div>\n                <div class=\"checks\">\n                  <label class=\"check\"><input name=\"showOpeningCountdown\" type=\"checkbox\">显示开放倒数</label>\n                  <label class=\"check\"><input name=\"showClosingCountdown\" type=\"checkbox\">显示截止倒数</label>\n                  <label class=\"check\"><input name=\"cancellationEnabled\" type=\"checkbox\">允许参加者取消</label>\n                  <label class=\"check\"><input name=\"seatExchangeEnabled\" type=\"checkbox\">允许参加者换座</label>\n                </div>\n                <div class=\"actions\">\n                  <button id=\"save-event\" type=\"submit\">保存草稿</button>\n                  <button class=\"secondary\" type=\"button\" data-action=\"close\">关闭为已结束</button>\n                  <button class=\"secondary\" type=\"button\" data-action=\"reopen\">重新开放</button>\n                  <button class=\"danger\" type=\"button\" data-action=\"archive\">归档</button>\n                </div>\n                <p class=\"warning\">重新开放前会显示现有报名人数，并要求明确确认。</p>\n              </form>\n              <div><div class=\"actions\"><button id=\"new-activity\" class=\"secondary\" type=\"button\">新建活动</button></div><div id=\"event-list\" class=\"data-list\" aria-label=\"活动列表\"></div></div>\n            </div>\n          </section>\n\n          <section id=\"selected-activity\" class=\"activity-context\" aria-live=\"polite\" hidden>\n            <div><p class=\"eyebrow\">Current activity</p><h2 id=\"selected-activity-title\"></h2><p id=\"selected-activity-meta\"></p></div>\n            <div class=\"actions\">\n              <button id=\"finalize-draft\" type=\"button\" hidden>确认建立活动并生成数据表</button>\n              <button id=\"delete-draft\" class=\"danger\" type=\"button\" hidden>删除草稿</button>\n              <button id=\"delete-empty-event\" class=\"danger\" type=\"button\" hidden>删除空活动</button>\n              <a id=\"selected-activity-sheet\" class=\"secondary\" target=\"_blank\" rel=\"noopener noreferrer\" hidden>打开活动数据表</a>\n            </div>\n          </section>\n          <p id=\"activity-empty-state\" class=\"empty-selection\">请选择一个活动，或先新建活动。</p>\n\n          <section id=\"sessions\" class=\"panel selected-required\">\n            <div class=\"panel-head\"><div><p class=\"eyebrow\">Programme</p><h2>场次</h2><p>编辑讲题、讲师、时间、地点、容量、必选和分组规则。</p></div></div>\n            <div class=\"panel-body split\">\n              <form id=\"session-form\">\n                <input name=\"sessionId\" type=\"hidden\"><input name=\"eventId\" type=\"hidden\">\n                <div class=\"fields\">\n                  <label>场次状态<select name=\"status\">\n                    <option value=\"draft\">draft</option><option value=\"upcoming\">upcoming</option><option value=\"open\">open</option>\n                    <option value=\"closed\">closed</option><option value=\"live\">live</option><option value=\"ended\">ended</option>\n                    <option value=\"cancelled\">cancelled</option><option value=\"archived\">archived</option>\n                  </select></label>\n                  <label class=\"wide\">标题<input name=\"title\" required></label>\n                  <label>讲师<input name=\"speaker\"></label><label>地点<input name=\"location\"></label>\n                  <label>开始时间<input name=\"startsAt\" type=\"datetime-local\"></label>\n                  <label>结束时间<input name=\"endsAt\" type=\"datetime-local\"></label>\n                  <label>容量<input name=\"capacity\" type=\"number\" min=\"0\" step=\"1\" value=\"0\"></label>\n                  <label>分组规则<input name=\"groupRule\"></label>\n                </div>\n                <label class=\"check\"><input name=\"required\" type=\"checkbox\">这是必选场次</label>\n                  <button id=\"save-session\" type=\"submit\">保存场次</button>\n              </form>\n              <div id=\"session-list\" class=\"data-list\" aria-label=\"场次列表\"></div>\n            </div>\n          </section>\n\n          <section id=\"seats\" class=\"panel selected-required\">\n            <div class=\"panel-head\"><div><p class=\"eyebrow\">Floor plan</p><h2>座位</h2><p>按活动／场次生成座位；已有座位只会保留或改变状态。</p></div></div>\n            <div class=\"panel-body split\">\n              <form id=\"seat-form\">\n                <input name=\"eventId\" type=\"hidden\">\n                <div class=\"fields\">\n                  <label>场次 ID<input name=\"sessionId\"></label>\n                  <label>模式<select name=\"mode\">\n                    <option value=\"none\">none 自由入座</option><option value=\"self\">self 自行选座</option>\n                    <option value=\"auto\">auto 系统分配</option><option value=\"zone\">zone 区域选择</option>\n                  </select></label>\n                  <label>区域名称<input name=\"zoneName\"></label>\n                  <label>行数<input name=\"rows\" type=\"number\" min=\"0\" step=\"1\" value=\"1\"></label>\n                  <label>每行座位<input name=\"seatsPerRow\" type=\"number\" min=\"0\" step=\"1\" value=\"1\"></label>\n                </div>\n                  <button id=\"save-seat-plan\" type=\"submit\">生成／更新座位方案</button>\n                <p class=\"warning\">保留、关闭与重新开放只改变座位状态，不会删除座位行。</p>\n              </form>\n              <div id=\"seat-list\" class=\"data-list\" aria-label=\"座位列表\"></div>\n            </div>\n          </section>\n\n          <section id=\"questions\" class=\"panel selected-required\">\n            <div class=\"panel-head\"><div><p class=\"eyebrow\">Registration form</p><h2>报名问题</h2><p>支持排序、显示／隐藏、必填、选项、验证、票面显示和重复身份判断。</p></div></div>\n            <div class=\"panel-body split\">\n              <form id=\"question-form\">\n                <input name=\"questionId\" type=\"hidden\"><input name=\"eventId\" type=\"hidden\">\n                <label>资料用途<select name=\"semanticRole\">\n                  <option value=\"\">一般问题</option>\n                  <option value=\"name\">姓名栏</option>\n                  <option value=\"email\">电邮栏</option>\n                  <option value=\"phone\">电话栏</option>\n                </select></label>\n                <div class=\"fields\">\n                  <label>字段类型<select name=\"type\">\n                    <option value=\"text\">text</option><option value=\"textarea\">textarea</option><option value=\"number\">number</option>\n                    <option value=\"tel\">tel</option><option value=\"email\">email</option><option value=\"date\">date</option>\n                    <option value=\"radio\">radio</option><option value=\"checkbox\">checkbox</option><option value=\"select\">select</option>\n                    <option value=\"boolean\">boolean</option>\n                  </select></label>\n                  <label class=\"wide\">问题文字<input name=\"label\" required></label>\n                  <label class=\"wide\">选项（每行一个）<textarea name=\"options\"></textarea></label>\n                  <label class=\"wide\">验证规则（JSON，例如 {\"minLength\":2}）<textarea name=\"validation\">{}</textarea></label>\n                  <label>排序<input name=\"sortOrder\" type=\"number\" min=\"0\" step=\"1\" value=\"0\"></label>\n                  <label>显示状态<select name=\"status\"><option value=\"active\">显示</option><option value=\"inactive\">隐藏</option></select></label>\n                </div>\n                <div class=\"checks\">\n                  <label class=\"check\"><input name=\"required\" type=\"checkbox\">必填</label>\n                  <label class=\"check\"><input name=\"showOnTicket\" type=\"checkbox\">显示在电子票</label>\n                  <label class=\"check\"><input name=\"duplicateIdentity\" type=\"checkbox\">用于重复身份判断</label>\n                </div>\n                  <button id=\"save-question\" type=\"submit\">保存问题</button>\n              </form>\n              <div id=\"question-list\" class=\"data-list\" aria-label=\"报名问题列表\"></div>\n            </div>\n          </section>\n\n          <section id=\"records\" class=\"panel selected-required generated-required\">\n            <div class=\"panel-head\"><div><p class=\"eyebrow\">History</p><h2>报名记录</h2><p>列表与搜索只显示脱敏资料；取消和调整座位保留全部历史。</p></div></div>\n            <div class=\"panel-body\">\n              <form id=\"record-search-form\" class=\"actions\">\n                <label>搜索报名号／票号／姓名／联系方式<input name=\"search\"></label>\n                <button type=\"submit\">搜索</button><button class=\"secondary\" type=\"button\" id=\"clear-search\">清除</button>\n              </form>\n              <form id=\"record-action-form\">\n                <div class=\"fields\">\n                  <label>报名 ID<input name=\"registrationId\" required></label>\n                  <label>新座位 ID<input name=\"seatId\"></label>\n                </div>\n                <div class=\"actions\">\n                  <button class=\"danger\" type=\"button\" data-action=\"cancel_registration\">确认取消报名</button>\n                  <button class=\"secondary\" type=\"button\" data-action=\"adjust_seat\">确认调整座位</button>\n                </div>\n              </form>\n              <div id=\"record-list\" class=\"data-list\" aria-label=\"脱敏报名记录\"></div>\n            </div>\n          </section>\n\n          <section id=\"attendance\" class=\"panel selected-required generated-required\">\n            <div class=\"panel-head\"><div><p class=\"eyebrow\">Door log</p><h2>签到记录</h2><p>按场次查看服务器时间签到历史。</p></div></div>\n            <div class=\"panel-body\"><div id=\"attendance-list\" class=\"data-list\" aria-label=\"签到记录\"></div></div>\n          </section>\n\n          <details class=\"advanced-maintenance\">\n            <summary>高级维护</summary>\n          <section id=\"sheet-settings\" class=\"panel\">\n            <div class=\"panel-head\"><div><p class=\"eyebrow\">Connection</p><h2>数据表连接</h2><p id=\"connection-status\">尚未读取连接状态。</p></div></div>\n            <div class=\"panel-body\">\n              <form id=\"sheet-form\">\n                <label>目标 Google Sheet ID<input name=\"spreadsheetId\" type=\"password\" autocomplete=\"off\" required></label>\n                <div class=\"actions\"><button type=\"button\" id=\"test-sheet\">测试连接</button><button class=\"danger\" type=\"button\" id=\"switch-sheet\">确认切换数据表</button></div>\n              </form>\n              <p class=\"warning\">切换是非破坏性的：旧数据仍保留在原数据表中，系统不会自动迁移任何数据。</p>\n            </div>\n          </section>\n\n          <section id=\"source-bundles\" class=\"panel\">\n            <div class=\"panel-head\"><div><p class=\"eyebrow\">Two deployments</p><h2>Apps Script 部署源码</h2><p>分别建立公开后端项目与员工／管理员项目；不可合并为同一个部署。</p></div></div>\n            <div class=\"panel-body\">\n              <div class=\"source-grid\">\n                <article class=\"source-card\"><h3>公开后端</h3><p>部署为执行者本人，允许匿名访问。只把此项目的 <code>/exec</code> URL 放进公开网页设置。</p><button type=\"button\" data-copy-bundle=\"publicBackend\">复制公开后端源码</button></article>\n                <article class=\"source-card\"><h3>员工／管理员</h3><p>部署为访问者本人，必须 Google 登录，并配置独立员工与管理员许可名单。</p><button type=\"button\" data-copy-bundle=\"staffAdmin\">复制员工／管理员源码</button></article>\n              </div>\n              <p class=\"warning\">源码包不会包含密码、许可名单值、当前数据表 ID、参加者资料或私人答案。</p>\n            </div>\n          </section>\n          </details>\n        </div>\n      </main>\n    </div>\n    <?!= HtmlService.createHtmlOutputFromFile('AdminScript').getContent(); ?>\n  </body>\n</html>\n\n===== staff-apps-script/AdminScript.html =====\n<script>\n  (() => {\n    \"use strict\";\n\n    const state = {\n      dashboard: null,\n      bundles: null,\n      selectedEventId: \"\",\n      selectedDraftId: \"\",\n      draftDocument: null,\n      draftNextStep: \"\",\n      search: \"\",\n      dashboardRequestId: 0,\n      eventSavePending: false,\n      eventSaveNotice: \"\",\n      actionNotice: \"\"\n    };\n    const statusNode = document.querySelector(\"#admin-status\");\n\n    function setStatus(message, kind = \"success\") {\n      statusNode.textContent = message;\n      statusNode.style.color = kind === \"error\" ? \"var(--danger)\" : \"var(--green)\";\n    }\n\n    function adminRunner_(success, isCurrent = () => true, onSettled = () => {}) {\n      return google.script.run\n        .withSuccessHandler((result) => {\n          if (!isCurrent()) return;\n          onSettled();\n          if (!result || result.ok !== true) {\n            setStatus(result && result.message ? result.message : \"管理员功能不可用。\", \"error\");\n            return;\n          }\n          success(result.data);\n        })\n        .withFailureHandler(() => {\n          if (!isCurrent()) return;\n          onSettled();\n          setStatus(\"管理员功能不可用。\", \"error\");\n        });\n    }\n\n    function setEventSavePending_(pending, activeButton) {\n      state.eventSavePending = pending;\n      const saveButton = document.querySelector(\"#save-event\");\n      if (pending) {\n        state.eventSaveButton = activeButton || saveButton;\n        state.eventSaveButtonText = state.eventSaveButton.textContent;\n        state.eventSaveButton.textContent =\n          state.eventSaveButton === saveButton ? \"正在保存…\" : \"处理中…\";\n      } else if (state.eventSaveButton) {\n        state.eventSaveButton.textContent = state.eventSaveButtonText;\n        state.eventSaveButton = null;\n        state.eventSaveButtonText = \"\";\n      }\n      saveButton.disabled = pending;\n      document.querySelectorAll(\"#event-form [data-action]\").forEach((button) => {\n        button.disabled = pending || !state.selectedEventId;\n      });\n    }\n\n    function runButtonAction_(button, pendingText, successText, invoke, onSuccess = () => {}) {\n      if (button.dataset.pending === \"true\") return;\n      const originalText = button.textContent;\n      button.dataset.pending = \"true\";\n      button.disabled = true;\n      button.textContent = pendingText;\n      const settle = () => {\n        delete button.dataset.pending;\n        button.disabled = false;\n        button.textContent = originalText;\n      };\n      const runner = adminRunner_((data) => {\n        onSuccess(data);\n        state.actionNotice = successText;\n        setStatus(successText);\n      }, undefined, settle);\n      invoke(runner);\n    }\n\n    function element(tag, text, className) {\n      const node = document.createElement(tag);\n      if (text !== undefined && text !== null) node.textContent = String(text);\n      if (className) node.className = className;\n      return node;\n    }\n\n    function replaceList(selector, items, render) {\n      const container = document.querySelector(selector);\n      container.replaceChildren();\n      if (!items || items.length === 0) {\n        container.append(element(\"p\", \"暂无记录。\", \"empty\"));\n        return;\n      }\n      items.forEach((item) => container.append(render(item)));\n    }\n\n    function dataRow(title, status, details) {\n      const row = element(\"article\", null, \"data-row\");\n      row.append(element(\"span\", status || \"record\", \"pill\"));\n      row.append(element(\"strong\", title || \"未命名\"));\n      (details || []).filter(Boolean).forEach((detail) => row.append(element(\"small\", detail)));\n      return row;\n    }\n\n    function editButton(label, handler) {\n      const button = element(\"button\", label);\n      button.type = \"button\";\n      button.className = \"secondary\";\n      button.addEventListener(\"click\", handler);\n      return button;\n    }\n\n    function safeSheetUrl(value) {\n      try {\n        const url = new URL(String(value || \"\"));\n        return url.protocol === \"https:\" && url.hostname === \"docs.google.com\" &&\n          /^\\/spreadsheets\\/d\\/[^/]+\\/edit\\/?$/.test(url.pathname) ? url.href : \"\";\n      } catch (_ignored) {\n        return \"\";\n      }\n    }\n\n    function draftStepLabel_(step) {\n      return {\n        activity: \"先填写并保存活动资料\",\n        sessions: \"建立讲座场次\",\n        seats: \"开放或生成座位\",\n        questions: \"建立报名问题\",\n        confirm: \"检查内容并确认生成数据表\"\n      }[step] || \"继续完成设置\";\n    }\n\n    function updateConditionalEventFields_() {\n      const form = document.querySelector(\"#event-form\");\n      const needsSessions = ![\"none\", \"free\"].includes(form.elements.selectionMode.value);\n      const needsSeats = form.elements.seatMode.value !== \"none\";\n      document.querySelector(\"#min-session-field\").hidden = !needsSessions;\n      document.querySelector(\"#max-session-field\").hidden = !needsSessions;\n      document.querySelector(\"#seat-zone-field\").hidden = !needsSeats;\n    }\n\n    function syncSelectedEventFields() {\n      [\"#session-form\", \"#seat-form\", \"#question-form\"].forEach((selector) => {\n        const form = document.querySelector(selector);\n        form.elements.eventId.value = state.selectedEventId;\n      });\n      const hasSelection = Boolean(state.selectedEventId || state.selectedDraftId);\n      const hasGeneratedActivity = Boolean(state.selectedEventId);\n      document.querySelectorAll(\".selected-required\").forEach((section) => {\n        section.hidden = !hasSelection;\n      });\n      document.querySelectorAll(\".generated-required\").forEach((section) => {\n        section.hidden = !hasGeneratedActivity;\n      });\n      document.querySelectorAll(\"#event-form [data-action]\").forEach((button) => {\n        button.disabled = !hasGeneratedActivity;\n      });\n      document.querySelectorAll('nav a[href^=\"#\"]').forEach((link) => {\n        const requiresActivity = link.getAttribute(\"href\") !== \"#events\";\n        const requiresGeneratedActivity = [\"#records\", \"#attendance\"]\n          .includes(link.getAttribute(\"href\"));\n        if (requiresActivity) {\n          const disabled = !hasSelection || (requiresGeneratedActivity && !hasGeneratedActivity);\n          link.setAttribute(\"aria-disabled\", String(disabled));\n          if (disabled) link.removeAttribute(\"aria-current\");\n        }\n      });\n      document.querySelector(\"#activity-empty-state\").hidden = hasSelection;\n      document.querySelector(\"#save-event\").textContent =\n        hasGeneratedActivity ? \"保存活动\" : \"保存草稿\";\n    }\n\n    function renderActivitySelector(events, drafts) {\n      const selector = document.querySelector(\"#activity-selector\");\n      selector.replaceChildren();\n      const placeholder = element(\"option\", \"选择活动\", \"\");\n      placeholder.value = \"\";\n      selector.append(placeholder);\n      (drafts || []).forEach((item) => {\n        const option = element(\"option\", `草稿：${item.draft.event.title || \"未命名活动\"}`);\n        option.value = `draft:${item.draftId}`;\n        selector.append(option);\n      });\n      events.forEach((item) => {\n        const option = element(\"option\", item.title || \"未命名活动\");\n        option.value = item.eventId;\n        selector.append(option);\n      });\n      selector.value = state.selectedDraftId\n        ? `draft:${state.selectedDraftId}` : state.selectedEventId;\n    }\n\n    function renderSelectedActivity(item, isDraft = false) {\n      const context = document.querySelector(\"#selected-activity\");\n      const title = document.querySelector(\"#selected-activity-title\");\n      const meta = document.querySelector(\"#selected-activity-meta\");\n      const sheetLink = document.querySelector(\"#selected-activity-sheet\");\n      const finalizeButton = document.querySelector(\"#finalize-draft\");\n      const deleteDraftButton = document.querySelector(\"#delete-draft\");\n      const deleteEventButton = document.querySelector(\"#delete-empty-event\");\n      context.hidden = !item;\n      if (!item) {\n        sheetLink.hidden = true;\n        sheetLink.removeAttribute(\"href\");\n        finalizeButton.hidden = true;\n        deleteDraftButton.hidden = true;\n        deleteEventButton.hidden = true;\n        return;\n      }\n      const event = isDraft ? item.draft.event : item;\n      title.textContent = isDraft\n        ? `正在设置：${event.title || \"新活动草稿\"}` : `正在设置：${event.title || \"未命名活动\"}`;\n      meta.textContent = isDraft\n        ? `尚未生成数据表 · 下一步：${draftStepLabel_(item.nextStep)}`\n        : `${event.status || \"draft\"}${event.location ? ` · ${event.location}` : \"\"}`;\n      finalizeButton.hidden = !isDraft;\n      finalizeButton.disabled = isDraft && item.nextStep !== \"confirm\";\n      deleteDraftButton.hidden = !isDraft;\n      deleteEventButton.hidden = isDraft || item.canDelete !== true;\n      const sheetUrl = safeSheetUrl(item.sheetUrl);\n      sheetLink.hidden = isDraft || !sheetUrl;\n      if (sheetUrl) sheetLink.href = sheetUrl;\n      else sheetLink.removeAttribute(\"href\");\n    }\n\n    function resetRelatedForms() {\n      [\"#session-form\", \"#seat-form\", \"#question-form\"].forEach((selector) => {\n        document.querySelector(selector).reset();\n      });\n      syncSelectedEventFields();\n    }\n\n    function selectActivity(eventId) {\n      const selectedValue = String(eventId || \"\");\n      state.selectedDraftId = selectedValue.startsWith(\"draft:\")\n        ? selectedValue.slice(6) : \"\";\n      state.selectedEventId = state.selectedDraftId ? \"\" : selectedValue;\n      state.draftDocument = null;\n      if (!state.selectedEventId && !state.selectedDraftId) {\n        const eventForm = document.querySelector(\"#event-form\");\n        eventForm.reset();\n        eventForm.elements.eventId.value = \"\";\n        renderSelectedActivity(null);\n      }\n      resetRelatedForms();\n      loadDashboard();\n    }\n\n    function startNewActivity() {\n      state.selectedEventId = \"\";\n      state.selectedDraftId = \"\";\n      state.draftDocument = null;\n      state.draftNextStep = \"\";\n      state.dashboardRequestId += 1;\n      document.querySelector(\"#event-form\").reset();\n      document.querySelector(\"#event-form\").elements.eventId.value = \"\";\n      resetRelatedForms();\n      renderSelectedActivity({\n        draftId: \"\",\n        draft: { event: { title: \"\" } },\n        nextStep: \"activity\"\n      }, true);\n      document.querySelector(\"#activity-selector\").value = \"\";\n      syncSelectedEventFields();\n      setStatus(\"正在建立新活动草稿（尚未生成数据表）。\");\n      document.querySelector(\"#event-form\").querySelector(\"input[name=title]\").focus();\n    }\n\n    function renderDashboard(data) {\n      data = data || {};\n      state.dashboard = data;\n      const events = Array.isArray(data.events) ? data.events : [];\n      const drafts = Array.isArray(data.drafts) ? data.drafts : [];\n      if (!events.some((item) => item.eventId === state.selectedEventId)) state.selectedEventId = \"\";\n      if (!drafts.some((item) => item.draftId === state.selectedDraftId)) state.selectedDraftId = \"\";\n      const selectedEvent = events.find((item) => item.eventId === state.selectedEventId) || null;\n      const selectedDraft = drafts.find((item) => item.draftId === state.selectedDraftId) || null;\n      if (selectedDraft) {\n        state.draftDocument = selectedDraft.draft;\n        state.draftNextStep = selectedDraft.nextStep;\n      }\n      renderActivitySelector(events, drafts);\n      renderSelectedActivity(selectedDraft || selectedEvent, Boolean(selectedDraft));\n      syncSelectedEventFields();\n      document.querySelector(\"#connection-status\").textContent = data.connection && data.connection.connected\n        ? `已连接：${data.connection.sheetName || \"Google Sheet\"}`\n        : \"未连接到数据表。\";\n      replaceList(\"#event-list\", drafts.concat(events), (item) => {\n        const isDraft = Boolean(item.draftId);\n        const event = isDraft ? item.draft.event : item;\n        const row = dataRow(event.title, isDraft ? \"草稿\" : event.status, [\n          event.location, `${event.selectionMode} · ${event.seatMode}`,\n          isDraft ? \"尚未生成数据表\" : `场次选择 ${event.minChoices}–${event.maxChoices}`\n        ]);\n        const selected = isDraft\n          ? item.draftId === state.selectedDraftId : item.eventId === state.selectedEventId;\n        const choose = editButton(selected ? \"正在管理\" : \"管理此活动\", () =>\n          selectActivity(isDraft ? `draft:${item.draftId}` : item.eventId));\n        choose.setAttribute(\"aria-pressed\", selected ? \"true\" : \"false\");\n        row.append(choose);\n        return row;\n      });\n      const visibleSessions = selectedDraft ? selectedDraft.draft.sessions : data.sessions;\n      const visibleQuestions = selectedDraft ? selectedDraft.draft.questions : data.questions;\n      replaceList(\"#session-list\", visibleSessions, (item) => {\n        const row = dataRow(item.title, item.status, [\n          item.speaker, item.location, `${item.startsAt || \"未定\"} → ${item.endsAt || \"未定\"}`,\n          `容量 ${item.capacity}${item.required ? \" · 必选\" : \"\"}${item.groupRule ? ` · ${item.groupRule}` : \"\"}`\n        ]);\n        row.append(editButton(\"编辑场次\", () =>\n          selectedDraft ? editDraftSession_(item) : editAdminSession(item)));\n        return row;\n      });\n      replaceList(\"#seat-list\", selectedDraft ? [] : data.seats, (item) => {\n        const row = dataRow(item.label, item.status, [item.zone, item.sessionId]);\n        const actions = element(\"div\", null, \"actions\");\n        [\"reserve\", \"close\", \"reopen\"].forEach((action) => {\n          const button = element(\"button\", action === \"reserve\" ? \"保留\" : action === \"close\" ? \"关闭\" : \"重新开放\");\n          button.type = \"button\";\n          button.className = \"secondary\";\n          button.dataset.action = action;\n          button.addEventListener(\"click\", () => saveSeatAction(action, item.seatId, button));\n          actions.append(button);\n        });\n        row.append(actions);\n        return row;\n      });\n      replaceList(\"#question-list\", visibleQuestions, (item) => {\n        const row = dataRow(item.label, item.status, [\n          `${item.type}${item.required ? \" · 必填\" : \"\"}`,\n          `排序 ${item.sortOrder}${item.showOnTicket ? \" · 票面显示\" : \"\"}${item.duplicateIdentity ? \" · 身份判断\" : \"\"}`\n        ]);\n        row.append(editButton(\"编辑问题\", () =>\n          selectedDraft ? editDraftQuestion_(item) : editAdminQuestion(item)));\n        return row;\n      });\n      replaceList(\"#record-list\", data.records, (item) =>\n        dataRow(`${item.ticketNumber} · ${item.participantName}`, item.status, [\n          item.registrationId, item.email || item.phone,\n          `场次 ${item.sessionIds.join(\", \") || \"无\"} · 座位 ${item.seatChoices.join(\", \") || \"无\"}`\n        ]));\n      replaceList(\"#attendance-list\", data.attendance, (item) =>\n        dataRow(item.registrationId, item.status, [\n          `场次 ${item.sessionId}`, item.checkedInAt, item.checkedInBy\n        ]));\n      if (selectedDraft) fillEventEditor(selectedDraft.draft.event);\n      else if (selectedEvent) fillEventEditor(selectedEvent);\n      updateConditionalEventFields_();\n      if ((selectedDraft || selectedEvent) && state.eventSaveNotice) {\n        setStatus(state.eventSaveNotice);\n        state.eventSaveNotice = \"\";\n        if (selectedDraft && state.draftNextStep) {\n          const target = {\n            sessions: \"#sessions\",\n            seats: \"#seats\",\n            questions: \"#questions\",\n            confirm: \"#selected-activity\"\n          }[state.draftNextStep] || \"#selected-activity\";\n          scrollToAdminSection_(target);\n        } else {\n          document.querySelector(\"#selected-activity\").scrollIntoView({\n            behavior: window.matchMedia &&\n              window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches ? \"auto\" : \"smooth\",\n            block: \"center\"\n          });\n        }\n      } else if (state.actionNotice) {\n        setStatus(state.actionNotice);\n        state.actionNotice = \"\";\n      } else {\n        setStatus(selectedDraft\n          ? `草稿已读取，下一步请${draftStepLabel_(selectedDraft.nextStep)}。`\n          : selectedEvent ? \"当前活动数据已更新。\" : \"请选择一个活动，或先新建活动。\");\n      }\n    }\n\n    function loadDashboard(search = state.search) {\n      state.search = search;\n      const requestId = ++state.dashboardRequestId;\n      const requestedEventId = state.selectedEventId;\n      const requestedDraftId = state.selectedDraftId;\n      const isCurrent = () => state.dashboardRequestId === requestId &&\n        state.selectedEventId === requestedEventId && state.selectedDraftId === requestedDraftId;\n      setStatus(\"正在读取管理数据…\");\n      const payload = { search };\n      if (requestedEventId) payload.eventId = requestedEventId;\n      adminRunner_(renderDashboard, isCurrent).getAdminDashboard(payload);\n    }\n\n    function formObject(form) {\n      return Object.fromEntries(new FormData(form).entries());\n    }\n\n    function checked(form, name) {\n      return form.elements[name].checked === true;\n    }\n\n    function localDateValue(value) {\n      return value ? new Date(value).toISOString() : \"\";\n    }\n\n    function localDateInput(value) {\n      if (!value) return \"\";\n      const date = new Date(value);\n      if (Number.isNaN(date.getTime())) return \"\";\n      const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);\n      return local.toISOString().slice(0, 16);\n    }\n\n    function focusEditor(form) {\n      form.scroll