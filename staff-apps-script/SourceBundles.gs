s.title.value = item.title;\n      form.elements.speaker.value = item.speaker;\n      form.elements.startsAt.value = localDateInput(item.startsAt);\n      form.elements.endsAt.value = localDateInput(item.endsAt);\n      form.elements.location.value = item.location;\n      form.elements.capacity.value = item.capacity;\n      form.elements.required.checked = item.required === true;\n      form.elements.groupRule.value = item.groupRule;\n      form.elements.status.value = item.status;\n      focusEditor(form);\n    }\n\n    function editDraftSession_(item) {\n      editAdminSession({\n        ...item,\n        eventId: \"\",\n        sessionId: item.draftKey || \"\"\n      });\n    }\n\n    function editAdminQuestion(item) {\n      const form = document.querySelector(\"#question-form\");\n      form.elements.questionId.value = item.questionId;\n      form.elements.eventId.value = item.eventId;\n      form.elements.label.value = item.label;\n      form.elements.type.value = item.type;\n      form.elements.options.value = (item.options || []).join(\"\\n\");\n      form.elements.validation.value = JSON.stringify(item.validation || {}, null, 2);\n      form.elements.sortOrder.value = item.sortOrder;\n      form.elements.status.value = item.status;\n      form.elements.required.checked = item.required === true;\n      form.elements.showOnTicket.checked = item.showOnTicket === true;\n      form.elements.duplicateIdentity.checked = item.duplicateIdentity === true;\n      form.elements.semanticRole.value = item.semanticRole || \"\";\n      focusEditor(form);\n    }\n\n    function editDraftQuestion_(item) {\n      editAdminQuestion({\n        ...item,\n        eventId: \"\",\n        questionId: item.draftKey || \"\"\n      });\n    }\n\n    function eventPayload(action) {\n      const form = document.querySelector(\"#event-form\");\n      const values = formObject(form);\n      const eventId = values.eventId;\n      delete values.eventId;\n      const payload = {\n        ...values,\n        action,\n        opensAt: localDateValue(values.opensAt),\n        closesAt: localDateValue(values.closesAt),\n        minChoices: Number(values.minChoices),\n        maxChoices: Number(values.maxChoices),\n        seatZones: values.seatZones.split(/\\r?\\n/).map((value) => value.trim()).filter(Boolean),\n        showOpeningCountdown: checked(form, \"showOpeningCountdown\"),\n        showClosingCountdown: checked(form, \"showClosingCountdown\"),\n        cancellationEnabled: checked(form, \"cancellationEnabled\"),\n        seatExchangeEnabled: checked(form, \"seatExchangeEnabled\"),\n        seatHoldsEnabled: checked(form, \"seatHoldsEnabled\"),\n        seatHoldMinutes: Number(values.seatHoldMinutes)\n      };\n      if (eventId) payload.eventId = eventId;\n      return payload;\n    }\n\n    function saveEvent(action, activeButton) {\n      if (state.eventSavePending) return;\n      const payload = eventPayload(action);\n      if (action && !payload.eventId) {\n        setStatus(\"请先选择一个活动，或先保存新活动。\", \"error\");\n        return;\n      }\n      const isNewActivity = !payload.eventId;\n      if (isNewActivity && !action) {\n        delete payload.action;\n        payload.status = \"draft\";\n        const draftDocument = state.draftDocument || {\n          event: payload,\n          sessions: [],\n          seatPlan: { mode: payload.seatMode || \"none\", sessionId: \"\", zones: [] },\n          questions: []\n        };\n        draftDocument.event = payload;\n        setEventSavePending_(true, activeButton);\n        setStatus(\"正在保存活动草稿…\");\n        const request = { ...draftDocument };\n        if (state.selectedDraftId) request.draftId = state.selectedDraftId;\n        adminRunner_((savedDraft) => {\n          state.selectedDraftId = savedDraft.draftId;\n          state.selectedEventId = \"\";\n          state.draftDocument = savedDraft.draft;\n          state.draftNextStep = savedDraft.nextStep;\n          state.eventSaveNotice =\n            `草稿保存成功，下一步请${draftStepLabel_(savedDraft.nextStep)}。`;\n          loadDashboard();\n        }, undefined, () => setEventSavePending_(false)).saveAdminDraft(request);\n        return;\n      }\n      if (action === \"reopen\") {\n        const count = state.dashboard && state.dashboard.records\n          ? new Set(state.dashboard.records.filter((record) => record.eventId === payload.eventId)\n            .map((record) => record.registrationId)).size : 0;\n        if (!window.confirm(`此活动已有 ${count} 个报名。确认重新开放？`)) return;\n        payload.confirm = true;\n      }\n      setEventSavePending_(true, activeButton);\n      setStatus(\"正在保存活动…\");\n      adminRunner_((savedEvent) => {\n        if (isNewActivity && savedEvent && savedEvent.eventId) state.selectedEventId = savedEvent.eventId;\n        state.eventSaveNotice = isNewActivity\n          ? \"活动建立成功，已显示刚建立的活动。\"\n          : \"活动保存成功，已显示最新内容。\";\n        loadDashboard();\n      }, undefined, () => setEventSavePending_(false)).saveAdminEvent(payload);\n    }\n\n    document.querySelector(\"#event-form\").addEventListener(\"submit\", (event) => {\n      event.preventDefault();\n      saveEvent(\"\", document.querySelector(\"#save-event\"));\n    });\n    document.querySelectorAll(\"#event-form [data-action]\").forEach((button) => {\n      button.addEventListener(\"click\", () => saveEvent(button.dataset.action, button));\n    });\n    document.querySelector(\"#activity-selector\").addEventListener(\"change\", (event) => {\n      selectActivity(event.currentTarget.value);\n    });\n    document.querySelector(\"#new-activity\").addEventListener(\"click\", startNewActivity);\n    document.querySelector(\"#event-form\").elements.selectionMode\n      .addEventListener(\"change\", updateConditionalEventFields_);\n    document.querySelector(\"#event-form\").elements.seatMode\n      .addEventListener(\"change\", updateConditionalEventFields_);\n\n    function persistDraftDocument_(documentValue, button, pendingText, successText) {\n      const request = { ...documentValue, draftId: state.selectedDraftId };\n      runButtonAction_(\n        button,\n        pendingText,\n        successText,\n        (runner) => runner.saveAdminDraft(request),\n        (savedDraft) => {\n          state.selectedDraftId = savedDraft.draftId;\n          state.draftDocument = savedDraft.draft;\n          state.draftNextStep = savedDraft.nextStep;\n          state.eventSaveNotice =\n            `${successText} 下一步请${draftStepLabel_(savedDraft.nextStep)}。`;\n          loadDashboard();\n        }\n      );\n    }\n\n    document.querySelector(\"#session-form\").addEventListener(\"submit\", (event) => {\n      event.preventDefault();\n      const form = event.currentTarget;\n      const values = formObject(form);\n      const payload = {\n        ...values,\n        sessionId: values.sessionId || undefined,\n        startsAt: localDateValue(values.startsAt),\n        endsAt: localDateValue(values.endsAt),\n        capacity: Number(values.capacity),\n        required: checked(form, \"required\")\n      };\n      if (state.selectedDraftId) {\n        const draftKey = values.sessionId ||\n          `draft-session-${state.draftDocument.sessions.length + 1}`;\n        delete payload.eventId;\n        delete payload.sessionId;\n        payload.draftKey = draftKey;\n        const sessions = state.draftDocument.sessions.slice();\n        const existingIndex = sessions.findIndex((item) => item.draftKey === draftKey);\n        if (existingIndex === -1) sessions.push(payload);\n        else sessions[existingIndex] = payload;\n        persistDraftDocument_(\n          { ...state.draftDocument, sessions },\n          document.querySelector(\"#save-session\"),\n          \"正在保存场次草稿…\",\n          \"场次草稿保存成功。\"\n        );\n        return;\n      }\n      runButtonAction_(\n        document.querySelector(\"#save-session\"),\n        \"正在保存场次…\",\n        \"场次保存成功。\",\n        (runner) => runner.saveAdminSession(payload),\n        () => loadDashboard()\n      );\n    });\n\n    document.querySelector(\"#seat-form\").addEventListener(\"submit\", (event) => {\n      event.preventDefault();\n      const values = formObject(event.currentTarget);\n      const mode = values.mode;\n      const payload = {\n        eventId: values.eventId,\n        sessionId: values.sessionId,\n        action: \"generate\",\n        mode,\n        zones: mode === \"none\" ? [] : [{\n          name: values.zoneName,\n          rows: Number(values.rows),\n          seatsPerRow: Number(values.seatsPerRow)\n        }]\n      };\n      if (state.selectedDraftId) {\n        persistDraftDocument_(\n          {\n            ...state.draftDocument,\n            seatPlan: {\n              mode,\n              sessionId: values.sessionId || \"\",\n              zones: payload.zones\n            }\n          },\n          document.querySelector(\"#save-seat-plan\"),\n          \"正在保存座位草稿…\",\n          \"座位方案草稿保存成功。\"\n        );\n        return;\n      }\n      runButtonAction_(\n        document.querySelector(\"#save-seat-plan\"),\n        \"正在保存座位…\",\n        \"座位方案保存成功。\",\n        (runner) => runner.saveAdminSeatPlan(payload),\n        () => loadDashboard()\n      );\n    });\n\n    function saveSeatAction(action, seatId, button) {\n      if (!state.selectedEventId) {\n        setStatus(\"请先选择一个活动，再更新座位。\", \"error\");\n        return;\n      }\n      const payload = { eventId: state.selectedEventId, action, seatId };\n      runButtonAction_(\n        button,\n        \"处理中…\",\n        \"座位状态更新成功。\",\n        (runner) => runner.saveAdminSeatPlan(payload),\n        () => loadDashboard()\n      );\n    }\n\n    document.querySelector(\"#question-form\").addEventListener(\"submit\", (event) => {\n      event.preventDefault();\n      const form = event.currentTarget;\n      const values = formObject(form);\n      let validation;\n      try {\n        validation = JSON.parse(values.validation || \"{}\");\n      } catch (_ignored) {\n        setStatus(\"验证规则必须是有效 JSON。\", \"error\");\n        return;\n      }\n      const payload = {\n        ...values,\n        questionId: values.questionId || undefined,\n        options: values.options.split(/\\r?\\n/).map((value) => value.trim()).filter(Boolean),\n        validation,\n        sortOrder: Number(values.sortOrder),\n        required: checked(form, \"required\"),\n        showOnTicket: checked(form, \"showOnTicket\"),\n        duplicateIdentity: checked(form, \"duplicateIdentity\"),\n        semanticRole: values.semanticRole\n      };\n      if (state.selectedDraftId) {\n        const draftKey = values.questionId ||\n          `draft-question-${state.draftDocument.questions.length + 1}`;\n        delete payload.eventId;\n        delete payload.questionId;\n        payload.draftKey = draftKey;\n        const questions = state.draftDocument.questions.slice();\n        const existingIndex = questions.findIndex((item) => item.draftKey === draftKey);\n        if (existingIndex === -1) questions.push(payload);\n        else questions[existingIndex] = payload;\n        persistDraftDocument_(\n          { ...state.draftDocument, questions },\n          document.querySelector(\"#save-question\"),\n          \"正在保存问题草稿…\",\n          \"问题草稿保存成功。\"\n        );\n        return;\n      }\n      runButtonAction_(\n        document.querySelector(\"#save-question\"),\n        \"正在保存问题…\",\n        \"问题保存成功。\",\n        (runner) => runner.saveAdminQuestion(payload),\n        () => loadDashboard()\n      );\n    });\n\n    document.querySelector(\"#finalize-draft\").addEventListener(\"click\", (event) => {\n      if (!state.selectedDraftId || state.draftNextStep !== \"confirm\") {\n        setStatus(\"请先完成系统提示的活动设置。\", \"error\");\n        return;\n      }\n      if (!window.confirm(\n        \"确认建立这个活动的数据表？建立后仍是草稿，不会自动开放报名。\"\n      )) return;\n      runButtonAction_(\n        event.currentTarget,\n        \"正在生成数据表…\",\n        \"数据表建立成功，活动仍是草稿。\",\n        (runner) => runner.finalizeAdminDraft({\n          draftId: state.selectedDraftId,\n          confirm: true\n        }),\n        (created) => {\n          state.selectedEventId = created.eventId;\n          state.selectedDraftId = \"\";\n          state.draftDocument = null;\n          state.draftNextStep = \"\";\n          state.eventSaveNotice = \"数据表建立成功；请检查后再开放报名。\";\n          loadDashboard();\n        }\n      );\n    });\n\n    document.querySelector(\"#delete-draft\").addEventListener(\"click\", (event) => {\n      if (!state.selectedDraftId) return;\n      if (!window.confirm(\"确认删除这个未生成数据表的活动草稿？\")) return;\n      runButtonAction_(\n        event.currentTarget,\n        \"正在删除草稿…\",\n        \"草稿已删除。\",\n        (runner) => runner.deleteAdminDraft({\n          draftId: state.selectedDraftId,\n          confirm: true\n        }),\n        () => {\n          state.selectedDraftId = \"\";\n          state.draftDocument = null;\n          state.draftNextStep = \"\";\n          loadDashboard();\n        }\n      );\n    });\n\n    document.querySelector(\"#delete-empty-event\").addEventListener(\"click\", (event) => {\n      if (!state.selectedEventId) return;\n      if (!window.confirm(\n        \"确认删除这个没有报名、票券或签到记录的活动？数据表会移到 Google Drive 回收站。\"\n      )) return;\n      runButtonAction_(\n        event.currentTarget,\n        \"正在删除空活动…\",\n        \"空活动已移到回收站。\",\n        (runner) => runner.deleteEmptyAdminEvent({\n          eventId: state.selectedEventId,\n          confirm: true\n        }),\n        () => {\n          state.selectedEventId = \"\";\n          loadDashboard();\n        }\n      );\n    });\n\n    document.querySelector(\"#record-search-form\").addEventListener(\"submit\", (event) => {\n      event.preventDefault();\n      loadDashboard(event.currentTarget.elements.search.value.trim());\n    });\n    document.querySelector(\"#clear-search\").addEventListener(\"click\", () => {\n      document.querySelector(\"#record-search-form\").reset();\n      loadDashboard();\n    });\n    document.querySelectorAll(\"#record-action-form [data-action]\").forEach((button) => {\n      button.addEventListener(\"click\", () => {\n        if (!state.selectedEventId) {\n          setStatus(\"请先选择一个活动，再更新报名记录。\", \"error\");\n          return;\n        }\n        const form = document.querySelector(\"#record-action-form\");\n        const values = formObject(form);\n        if (!window.confirm(\"确认执行此操作并保留完整历史记录？\")) return;\n        const payload = {\n          eventId: state.selectedEventId,\n          action: button.dataset.action,\n          registrationId: values.registrationId,\n          seatId: values.seatId,\n          confirm: true\n        };\n        runButtonAction_(\n          button,\n          \"处理中…\",\n          \"报名记录更新成功。\",\n          (runner) => runner.adminRecordAction(payload),\n          () => loadDashboard()\n        );\n      });\n    });\n\n    document.querySelector(\"#test-sheet\").addEventListener(\"click\", () => {\n      const spreadsheetId = document.querySelector(\"#sheet-form\").elements.spreadsheetId.value.trim();\n      setStatus(\"正在测试数据表连接…\");\n      adminRunner_((data) => {\n        document.querySelector(\"#connection-status\").textContent = `测试成功：${data.sheetName}`;\n        setStatus(\"目标数据表连接正常。\");\n      }).testAdminSheetConnection({ spreadsheetId });\n    });\n    document.querySelector(\"#switch-sheet\").addEventListener(\"click\", () => {\n      const spreadsheetId = document.querySelector(\"#sheet-form\").elements.spreadsheetId.value.trim();\n      if (!window.confirm(\"确认切换？旧数据会保留，系统不会自动迁移。\")) return;\n      setStatus(\"正在由统一后端验证并切换数据表…\");\n      adminRunner_((completed) => {\n        setStatus(completed.warning);\n        document.querySelector(\"#sheet-form\").reset();\n        loadDashboard();\n      }).switchAdminSheet({ spreadsheetId, confirm: true });\n    });\n\n    function loadBundles(onReady) {\n      if (state.bundles) {\n        onReady(state.bundles);\n        return;\n      }\n      setStatus(\"正在准备部署源码…\");\n      adminRunner_((bundles) => {\n        state.bundles = bundles;\n        onReady(bundles);\n      }).getAdminSourceBundles({});\n    }\n\n    document.querySelectorAll(\"[data-copy-bundle]\").forEach((button) => {\n      button.addEventListener(\"click\", () => {\n        loadBundles((bundles) => {\n          const key = button.dataset.copyBundle;\n          const source = bundles && typeof bundles[key] === \"string\" ? bundles[key] : \"\";\n          if (!source) {\n            setStatus(\"源码包不可用。\", \"error\");\n            return;\n          }\n          navigator.clipboard.writeText(source)\n            .then(() => setStatus(\"源码已复制；请按文件分隔标记建立独立 Apps Script 项目。\"))\n            .catch(() => setStatus(\"无法写入剪贴板，请检查浏览器权限。\", \"error\"));\n        });\n      });\n    });\n\n    function scrollToAdminSection_(targetId) {\n      const target = document.querySelector(targetId);\n      if (!target) return;\n      if (target.hidden) {\n        setStatus(\"请先选择一个活动，再管理该部分。\", \"error\");\n        document.querySelector(\"#activity-selector\").focus();\n        return;\n      }\n      if (window.matchMedia && window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches) {\n        target.scrollIntoView({ behavior: \"auto\", block: \"start\" });\n      } else {\n        target.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n      }\n      document.querySelectorAll('nav a[href^=\"#\"]').forEach((link) => {\n        if (link.getAttribute(\"href\") === targetId) link.setAttribute(\"aria-current\", \"page\");\n        else link.removeAttribute(\"aria-current\");\n      });\n    }\n\n    document.querySelectorAll('nav a[href^=\"#\"]').forEach((link) => {\n      link.addEventListener(\"click\", (event) => {\n        event.preventDefault();\n        scrollToAdminSection_(link.getAttribute(\"href\"));\n      });\n    });\n\n    loadDashboard();\n  })();\n</script>\n";
