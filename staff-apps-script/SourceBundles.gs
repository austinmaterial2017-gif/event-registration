learAdminSwitchState_(registry);\\n    adminError_('SHEET_CONNECTION_FAILED');\\n  }\\n\\n  var ack = parseAdminSwitchObject_(getSharedSettingValue_(registry, SWITCH_PROBE_ACK));\\n  var configuration = requireSwitchProbeConfiguration_();\\n  if (!isValidAdminSwitchAck_(ack, probe, configuration.secret)) {\\n    clearAdminSwitchState_(registry);\\n    adminError_('SHEET_CONNECTION_FAILED');\\n  }\\n\\n  var candidate;\\n  try {\\n    candidate = openSpreadsheetById_(probe.candidateSpreadsheetId);\\n    validateAdminSpreadsheet_(candidate);\\n  } catch (error) {\\n    clearAdminSwitchState_(registry);\\n    if (error && error.publicCode) throw error;\\n    adminError_('SHEET_CONNECTION_FAILED');\\n  }\\n\\n  var pointer = String(registry.getId()) === probe.candidateSpreadsheetId\\n    ? ''\\n    : probe.candidateSpreadsheetId;\\n  setSharedSettingValue_(registry, ACTIVE_SPREADSHEET_ID, pointer);\\n  setSharedSettingValue_(registry, SWITCH_MAINTENANCE, '');\\n  try {\\n    setSharedSettingValue_(registry, SWITCH_PROBE, '');\\n    setSharedSettingValue_(registry, SWITCH_PROBE_ACK, '');\\n  } catch (_ignored) {\\n    // Maintenance is already cleared after publication; stale probe rows are inert.\\n  }\\n  return {\\n    connected: true,\\n    sheetName: String(candidate.getName ? candidate.getName() : 'Connected'),\\n    warning: '旧数据仍保留在原数据表中；系统不会自动迁移任何数据。'\\n  };\\n}\\n\\nfunction requireSwitchProbeConfiguration_() {\\n  var properties = PropertiesService.getScriptProperties();\\n  var secret = properties.getProperty(SWITCH_PROBE_SHARED_SECRET);\\n  var publicBackendUrl = properties.getProperty(PUBLIC_BACKEND_URL);\\n  if (typeof secret !== 'string' || secret.length < 32 ||\\n      typeof publicBackendUrl !== 'string' ||\\n      !/^https:\\\\/\\\\/script\\\\.google\\\\.com\\\\/macros\\\\/s\\\\/[^/?#]+\\\\/exec$/.test(publicBackendUrl)) {\\n    adminError_('SHEET_CONNECTION_FAILED');\\n  }\\n  return { secret: secret, publicBackendUrl: publicBackendUrl };\\n}\\n\\nfunction createAdminSwitchNonce_(secret) {\\n  var randomInput = Utilities.getUuid() + '\\\\n' + Utilities.getUuid();\\n  return Utilities.base64EncodeWebSafe(\\n    Utilities.computeHmacSha256Signature(randomInput, secret)\\n  );\\n}\\n\\nfunction isValidAdminSwitchAck_(ack, probe, secret) {\\n  if (!ack || ack.nonce !== probe.nonce || ack.expiresAt !== probe.expiresAt ||\\n      typeof ack.verifiedAt !== 'string' || typeof ack.signature !== 'string') {\\n    return false;\\n  }\\n  var verifiedAt = new Date(ack.verifiedAt).getTime();\\n  var expiresAt = new Date(probe.expiresAt).getTime();\\n  if (!isFinite(verifiedAt) || !isFinite(expiresAt) || verifiedAt > expiresAt) return false;\\n  return ack.signature === signAdminSwitchAck_(\\n    probe.nonce,\\n    probe.candidateSpreadsheetId,\\n    probe.expiresAt,\\n    secret\\n  );\\n}\\n\\nfunction signAdminSwitchAck_(nonce, candidateSpreadsheetId, expiresAt, secret) {\\n  return Utilities.base64EncodeWebSafe(\\n    Utilities.computeHmacSha256Signature(\\n      nonce + '\\\\n' + candidateSpreadsheetId + '\\\\n' + expiresAt,\\n      secret\\n    )\\n  );\\n}\\n\\nfunction parseAdminSwitchObject_(serialized) {\\n  if (typeof serialized !== 'string' || !serialized.trim()) return null;\\n  try {\\n    var value = JSON.parse(serialized);\\n    return value && typeof value === 'object' && !Array.isArray(value) ? value : null;\\n  } catch (_ignored) {\\n    return null;\\n  }\\n}\\n\\nfunction isFutureSwitchTime_(serialized) {\\n  if (typeof serialized !== 'string') return false;\\n  var time = new Date(serialized).getTime();\\n  return isFinite(time) && time > Date.now();\\n}\\n\\nfunction clearAdminSwitchState_(registry) {\\n  setSharedSettingValue_(registry, SWITCH_MAINTENANCE, '');\\n  setSharedSettingValue_(registry, SWITCH_PROBE, '');\\n  setSharedSettingValue_(registry, SWITCH_PROBE_ACK, '');\\n}\\n\\nfunction getAdminSourceBundles_(payload) {\\n  if (payload !== undefined && payload !== null &&\\n      (typeof payload !== 'object' || Array.isArray(payload))) {\\n    adminError_('INVALID_REQUEST');\\n  }\\n  return {\\n    publicBackend: PUBLIC_BACKEND_SOURCE_BUNDLE_,\\n    staffAdmin: STAFF_ADMIN_SOURCE_BUNDLE_\\n  };\\n}\\n\\nfunction validateAdminSpreadsheet_(spreadsheet) {\\n  Object.keys(STAFF_SHEET_DEFINITIONS).forEach(function(sheetName) {\\n    var sheet = spreadsheet.getSheetByName(sheetName);\\n    if (!sheet || sheet.getLastRow() < 1) adminError_('SHEET_CONNECTION_FAILED');\\n    var expected = STAFF_SHEET_DEFINITIONS[sheetName];\\n    var actual = sheet.getRange(1, 1, 1, expected.length).getValues()[0];\\n    if (!expected.every(function(header, index) { return actual[index] === header; })) {\\n      adminError_('SHEET_CONNECTION_FAILED');\\n    }\\n  });\\n  return true;\\n}\\n\\nfunction requireAdminObject_(payload) {\\n  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) {\\n    adminError_('INVALID_REQUEST');\\n  }\\n  return payload;\\n}\\n\\nfunction readAdminRows_(spreadsheet, sheetName) {\\n  var sheet = getRequiredSheet_(spreadsheet, sheetName);\\n  if (sheet.getLastRow() <= 1) return [];\\n  var headers = STAFF_SHEET_DEFINITIONS[sheetName];\\n  return sheet.getRange(2, 1, sheet.getLastRow() - 1, headers.length).getValues().map(function(values, index) {\\n    var row = { rowNumber: index + 2 };\\n    headers.forEach(function(header, column) { row[header] = values[column]; });\\n    return row;\\n  });\\n}\\n\\nfunction findAdminRow_(spreadsheet, sheetName, key, value) {\\n  return readAdminRows_(spreadsheet, sheetName).filter(function(row) {\\n    return row[key] === value;\\n  })[0] || null;\\n}\\n\\nfunction writeAdminRow_(spreadsheet, sheetName, rowNumber, row) {\\n  var sheet = getRequiredSheet_(spreadsheet, sheetName);\\n  var values = normalizeRow_(sheetName, row);\\n  var targetRow = rowNumber || sheet.getLastRow() + 1;\\n  sheet.getRange(targetRow, 1, 1, values.length).setValues([values]);\\n  return targetRow;\\n}\\n\\nfunction snapshotAdminRows_(spreadsheet, sheetName, rows) {\\n  var sheet = getRequiredSheet_(spreadsheet, sheetName);\\n  return rows.map(function(row) {\\n    return {\\n      sheet: sheet,\\n      rowNumber: row.rowNumber,\\n      values: normalizeRow_(sheetName, row)\\n    };\\n  });\\n}\\n\\nfunction restoreAdminSnapshots_(snapshots) {\\n  var failures = [];\\n  snapshots.forEach(function(snapshot) {\\n    try {\\n      snapshot.sheet.getRange(\\n        snapshot.rowNumber, 1, 1, snapshot.values.length\\n      ).setValues([snapshot.values]);\\n    } catch (error) {\\n      failures.push(error);\\n    }\\n  });\\n  return failures;\\n}\\n\\nfunction appendAdminAudit_(spreadsheet, action, entityType, entityId, actor, details) {\\n  writeAdminRow_(spreadsheet, '操作记录', null, {\\n    auditId: Utilities.getUuid(),\\n    action: action,\\n    entityType: entityType,\\n    entityId: entityId,\\n    actor: actor,\\n    details: JSON.stringify(details || {}),\\n    createdAt: new Date().toISOString()\\n  });\\n}\\n\\nfunction appendAdminAuditSafely_(spreadsheet, action, entityType, entityId, actor, details) {\\n  try {\\n    appendAdminAudit_(spreadsheet, action, entityType, entityId, actor, details);\\n    return null;\\n  } catch (error) {\\n    return error;\\n  }\\n}\\n\\nfunction adminField_(source, key, existing, fallback) {\\n  if (Object.prototype.hasOwnProperty.call(source, key)) return source[key];\\n  if (existing !== undefined && existing !== null && existing !== '') return existing;\\n  return fallback;\\n}\\n\\nfunction adminTextField_(source, key, existing, fallback) {\\n  var value = adminField_(source, key, existing, fallback);\\n  if (value === undefined || value === null) return '';\\n  if (typeof value !== 'string' || value.length > 5000) adminError_('INVALID_REQUEST');\\n  return value.trim();\\n}\\n\\nfunction adminBooleanField_(source, key, existing, fallback) {\\n  if (!Object.prototype.hasOwnProperty.call(source, key)) {\\n    return existing === undefined || existing === null ? fallback : existing === true;\\n  }\\n  if (typeof source[key] !== 'boolean') adminError_('INVALID_REQUEST');\\n  return source[key];\\n}\\n\\nfunction copyAdminBooleanField_(source, target, key) {\\n  if (!Object.prototype.hasOwnProperty.call(source, key)) return;\\n  if (typeof source[key] !== 'boolean') adminError_('INVALID_REQUEST');\\n  target[key] = source[key];\\n}\\n\\nfunction adminDateField_(value) {\\n  if (value === '' || value === undefined || value === null) return '';\\n  var text = String(value).trim();\\n  if (!text || !isFinite(Date.parse(text))) adminError_('INVALID_REQUEST');\\n  return text;\\n}\\n\\nfunction adminNonNegativeInteger_(value) {\\n  var number = Number(value);\\n  if (!isFinite(number) || number < 0 || Math.floor(number) !== number) {\\n    adminError_('INVALID_REQUEST');\\n  }\\n  return number;\\n}\\n\\nfunction adminPositiveInteger_(value) {\\n  var number = adminNonNegativeInteger_(value);\\n  if (number < 1) adminError_('INVALID_REQUEST');\\n  return number;\\n}\\n\\nfunction adminTruthy_(value) {\\n  return value === true || value === 1 || String(value).toLowerCase() === 'true' || String(value) === '1';\\n}\\n\\nfunction ensureAdminEventPolicy_(settings, eventId) {\\n  if (!settings.registration || typeof settings.registration !== 'object' ||\\n      Array.isArray(settings.registration)) settings.registration = {};\\n  if (!settings.registration.events || typeof settings.registration.events !== 'object' ||\\n      Array.isArray(settings.registration.events)) settings.registration.events = {};\\n  if (!settings.registration.events[eventId] ||\\n      typeof settings.registration.events[eventId] !== 'object' ||\\n      Array.isArray(settings.registration.events[eventId])) {\\n    settings.registration.events[eventId] = {};\\n  }\\n  return settings.registration.events[eventId];\\n}\\n\\nfunction ensureAdminSessionPolicy_(settings, eventId, sessionId) {\\n  var eventPolicy = ensureAdminEventPolicy_(settings, eventId);\\n  if (!eventPolicy.sessions || typeof eventPolicy.sessions !== 'object' ||\\n      Array.isArray(eventPolicy.sessions)) eventPolicy.sessions = {};\\n  if (!eventPolicy.sessions[sessionId] || typeof eventPolicy.sessions[sessionId] !== 'object' ||\\n      Array.isArray(eventPolicy.sessions[sessionId])) eventPolicy.sessions[sessionId] = {};\\n  return eventPolicy.sessions[sessionId];\\n}\\n\\nfunction adminEventProjection_(event, settings) {\\n  var policy = ensureAdminEventPolicy_(settings || {}, event.eventId);\\n  return {\\n    eventId: String(event.eventId || ''),\\n    title: String(event.title || ''),\\n    description: String(event.description || ''),\\n    status: String(event.status || ''),\\n    opensAt: String(event.opensAt || ''),\\n    closesAt: String(event.closesAt || ''),\\n    location: String(event.location || ''),\\n    selectionMode: String(event.selectionMode || ''),\\n    minChoices: Number(event.minChoices || 0),\\n    maxChoices: Number(event.maxChoices || 0),\\n    seatMode: String(event.seatMode || 'none'),\\n    seatZones: parseAdminStringArray_(event.seatZones),\\n    showOpeningCountdown: policy.showOpeningCountdown === true,\\n    showClosingCountdown: policy.showClosingCountdown === true,\\n    cancellationEnabled: policy.cancellationEnabled === true,\\n    seatExchangeEnabled: policy.seatExchangeEnabled === true,\\n    createdAt: String(event.createdAt || ''),\\n    updatedAt: String(event.updatedAt || '')\\n  };\\n}\\n\\nfunction adminSessionProjection_(session, settings) {\\n  var eventPolicy = ensureAdminEventPolicy_(settings || {}, session.eventId);\\n  var policy = eventPolicy.sessions && eventPolicy.sessions[session.sessionId] || {};\\n  return {\\n    sessionId: String(session.sessionId || ''),\\n    eventId: String(session.eventId || ''),\\n    title: String(session.title || ''),\\n    speaker: String(session.speaker || ''),\\n    startsAt: String(session.startsAt || ''),\\n    endsAt: String(session.endsAt || ''),\\n    location: String(policy.location || ''),\\n    capacity: Number(session.capacity || 0),\\n    required: adminTruthy_(session.required),\\n    groupRule: String(policy.groupRule || ''),\\n    status: String(session.status || ''),\\n    createdAt: String(session.createdAt || ''),\\n    updatedAt: String(session.updatedAt || '')\\n  };\\n}\\n\\nfunction adminSeatProjection_(seat) {\\n  return {\\n    seatId: String(seat.seatId || ''),\\n    eventId: String(seat.eventId || ''),\\n    sessionId: String(seat.sessionId || ''),\\n    label: String(seat.label || ''),\\n    zone: String(seat.zone || ''),\\n    status: String(seat.status || ''),\\n    holderRegistrationId: seat.holderRegistrationId ? 'assigned' : '',\\n    createdAt: String(seat.createdAt || ''),\\n    updatedAt: String(seat.updatedAt || '')\\n  };\\n}\\n\\nfunction adminQuestionProjection_(question, settings) {\\n  var policy = ensureAdminEventPolicy_(settings || {}, question.eventId);\\n  var identityFields = Array.isArray(policy.identityFields) ? policy.identityFields :\\n    (settings && settings.registration && Array.isArray(settings.registration.identityFields)\\n      ? settings.registration.identityFields : []);\\n  var parsed = parseAdminQuestionOptions_(question.options);\\n  return {\\n    questionId: String(question.questionId || ''),\\n    eventId: String(question.eventId || ''),\\n    label: String(question.label || ''),\\n    type: String(question.type || ''),\\n    required: adminTruthy_(question.required),\\n    options: parsed.choices,\\n    validation: parsed.validation,\\n    sortOrder: Number(question.sortOrder || 0),\\n    status: String(question.status || ''),\\n    showOnTicket: adminListHas_(policy.showOnTicketFields, question.questionId),\\n    duplicateIdentity: adminListHas_(identityFields, question.questionId),\\n    createdAt: String(question.createdAt || ''),\\n    updatedAt: String(question.updatedAt || '')\\n  };\\n}\\n\\nfunction parseAdminQuestionOptions_(serialized) {\\n  if (!serialized) return { choices: [], validation: {} };\\n  try {\\n    var parsed = typeof serialized === 'string' ? JSON.parse(serialized) : serialized;\\n    if (Array.isArray(parsed)) return { choices: parsed, validation: {} };\\n    if (!parsed || typeof parsed !== 'object') return { choices: [], validation: {} };\\n    return {\\n      choices: Array.isArray(parsed.choices) ? parsed.choices :\\n        (Array.isArray(parsed.options) ? parsed.options : []),\\n      validation: parsed.validation && typeof parsed.validation === 'object' &&\\n        !Array.isArray(parsed.validation) ? parsed.validation : {}\\n    };\\n  } catch (_ignored) {\\n    return { choices: [], validation: {} };\\n  }\\n}\\n\\nfunction parseAdminStringArray_(serialized) {\\n  if (Array.isArray(serialized)) {\\n    return serialized.filter(function(value) { return typeof value === 'string'; });\\n  }\\n  try {\\n    var parsed = JSON.parse(serialized || '[]');\\n    return Array.isArray(parsed)\\n      ? parsed.filter(function(value) { return typeof value === 'string'; })\\n      : [];\\n  } catch (_ignored) {\\n    return [];\\n  }\\n}\\n\\nfunction parseAdminAnswers_(serialized) {\\n  try {\\n    var parsed = typeof serialized === 'string' ? JSON.parse(serialized) : serialized;\\n    if (parsed && typeof parsed === 'object' && parsed.values &&\\n        typeof parsed.values === 'object' && !Array.isArray(parsed.values)) return parsed;\\n    return { values: parsed && typeof parsed === 'object' ? parsed : {} };\\n  } catch (_ignored) {\\n    return { values: {} };\\n  }\\n}\\n\\nfunction maskAdminName_(value) {\\n  var text = String(value || '').trim();\\n  if (!text) return '';\\n  return text.slice(0, 1) + new Array(Math.max(2, text.length)).join('*');\\n}\\n\\nfunction maskAdminValue_(value) {\\n  if (typeof value === 'boolean') return '****';\\n  var text = String(value === undefined || value === null ? '' : value).trim();\\n  if (!text) return '';\\n  if (text.indexOf('@') !== -1) {\\n    var parts = text.split('@');\\n    return parts[0].slice(0, 1) + '***@' + parts.slice(1).join('@');\\n  }\\n  return text.length <= 4 ? '****' : text.slice(0, 2) + '****' + text.slice(-2);\\n}\\n\\nfunction maskAdminAnswers_(answers) {\\n  var masked = {};\\n  Object.keys(answers || {}).forEach(function(key) {\\n    var value = answers[key];\\n    if (Array.isArray(value)) {\\n      masked[key] = value.map(maskAdminValue_);\\n    } else {\\n      masked[key] = maskAdminValue_(value);\\n    }\\n  });\\n  return masked;\\n}\\n\\nfunction adminListHas_(values, value) {\\n  return Array.isArray(values) && values.indexOf(value) !== -1;\\n}\\n\\nfunction updateAdminFlagList_(values, value, enabled) {\\n  var list = Array.isArray(values) ? values.filter(function(item) {\\n    return typeof item === 'string' && item !== value;\\n  }) : [];\\n  if (enabled) list.push(value);\\n  return list;\\n}\\n\\nfunction validateAdminIdentityFields_(identityFields, questions, candidate) {\\n  if (!Array.isArray(identityFields)) adminError_('CONFLICT');\\n  if (!identityFields.length) return;\\n  var questionsById = {};\\n  questions.forEach(function(question) {\\n    if (question.eventId === candidate.eventId) questionsById[question.questionId] = question;\\n  });\\n  questionsById[candidate.questionId] = candidate;\\n  var seen = {};\\n  identityFields.forEach(function(questionId) {\\n    if (typeof questionId !== 'string' || !questionId || seen[questionId]) {\\n      adminError_('CONFLICT');\\n    }\\n    seen[questionId] = true;\\n    var question = questionsById[questionId];\\n    if (!question || String(question.status || '').toLowerCase() !== 'active' ||\\n        !adminTruthy_(question.required)) {\\n      adminError_('CONFLICT');\\n    }\\n  });\\n}\\n\\n===== staff-apps-script/Code.gs =====\\n/** The dedicated signed-in Web App has no anonymous API surface. */\\nfunction doGet(event) {\\n  var view = event && event.parameter && event.parameter.view;\\n  if (view === 'admin') {\\n    try {\\n      requireAuthorizedAdminSession_();\\n      return HtmlService.createTemplateFromFile('Admin')\\n        .evaluate()\\n        .setTitle('活动管理后台');\\n    } catch (_ignored) {\\n      return HtmlService\\n        .createHtmlOutput('<!doctype html><html><body><main><h1>Administrator access unavailable.</h1></main></body></html>')\\n        .setTitle('Administrator access unavailable');\\n    }\\n  }\\n  try {\\n    requireAuthorizedStaffSession_();\\n    return HtmlService.createHtmlOutputFromFile('StaffCheckIn')\\n      .setTitle('员工讲座签到');\\n  } catch (_ignored) {\\n    return HtmlService\\n      .createHtmlOutput('<!doctype html><html><body><main><h1>Staff access unavailable.</h1></main></body></html>')\\n      .setTitle('Staff access unavailable');\\n  }\\n}\\n\\n===== staff-apps-script/StaffCheckIn.html =====\\n<!doctype html>\\n<html lang=\\\"zh-CN\\\">\\n  <head>\\n    <base target=\\\"_top\\\">\\n    <meta charset=\\\"utf-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n    <style>\\n      body { margin:0; padding:24px; background:#18131d; color:#f8f0df; font:15px/1.5 Arial,sans-serif; }\\n      main { max-width:560px; margin:auto; } form, section { display:grid; gap:14px; padding:20px; border:1px solid #594463; border-radius:18px; background:#2b202f; }\\n      label { display:grid; gap:6px; } input, select, button { min-height:44px; padding:9px 11px; border-radius:10px; font:inherit; }\\n      input, select { border:1px solid #6b5874; background:#171219; color:#fff; } button { border:0; background:linear-gradient(110deg,#ff4fa3,#8755ff); color:#fff; font-weight:800; cursor:pointer; }\\n      .confirm { display:flex; align-items:flex-start; gap:8px; }.confirm input { min-height:auto; margin-top:5px; }.message { min-height:1.5em; color:#77e4aa; }\\n      [hidden] { display:none !important; }\\n    </style>\\n  </head>\\n  <body>\\n    <main>\\n      <h1>员工讲座签到</h1>\\n      <p>员工身份来自当前 Google 登录会话，页面不会接受手动填写的身份。</p>\\n      <form id=\\\"lookup-form\\\">\\n        <label>二维码 token\\n          <input name=\\\"token\\\" autocomplete=\\\"off\\\" required>\\n        </label>\\n        <button type=\\\"submit\\\">读取凭证</button>\\n      </form>\\n      <form id=\\\"check-in-form\\\" hidden>\\n        <p id=\\\"ticket-summary\\\"></p>\\n        <label>签到场次\\n          <select name=\\\"sessionId\\\" required>\\n            <option value=\\\"\\\">请选择场次</option>\\n          </select>\\n        </label>\\n        <label class=\\\"confirm\\\">\\n          <input name=\\\"confirmCheckIn\\\" type=\\\"checkbox\\\" required>\\n          我已当面核对参与者和本场讲座\\n        </label>\\n        <button type=\\\"submit\\\">确认本场签到</button>\\n      </form>\\n      <p id=\\\"message\\\" class=\\\"message\\\" role=\\\"status\\\"></p>\\n    </main>\\n    <script>\\n      const lookupForm = document.querySelector(\\\"#lookup-form\\\");\\n      const checkInForm = document.querySelector(\\\"#check-in-form\\\");\\n      const message = document.querySelector(\\\"#message\\\");\\n      const summary = document.querySelector(\\\"#ticket-summary\\\");\\n      let activeToken = \\\"\\\";\\n\\n      function showResult(result) {\\n        if (!result || result.ok !== true) {\\n          message.textContent = result && result.message ? result.message : \\\"员工签到不可用。\\\";\\n          return;\\n        }\\n        const ticket = result.data;\\n        summary.textContent = `${ticket.participantName} · ${ticket.event.title} · ${ticket.status}`;\\n        const select = checkInForm.elements.sessionId;\\n        select.length = 1;\\n        ticket.sessions.forEach((session) => {\\n          const option = document.createElement(\\\"option\\\");\\n          option.value = session.sessionId;\\n          option.textContent = `${session.title} · ${session.speaker || \\\"讲师待公布\\\"}`;\\n          select.append(option);\\n        });\\n        checkInForm.hidden = ticket.status !== \\\"active\\\";\\n        message.textContent = \\\"已读取凭证；请选择本次签到场次。\\\";\\n      }\\n\\n      lookupForm.addEventListener(\\\"submit\\\", (event) => {\\n        event.preventDefault();\\n        activeToken = lookupForm.elements.token.value.trim();\\n        message.textContent = \\\"正在读取凭证…\\\";\\n        google.script.run\\n          .withSuccessHandler(showResult)\\n          .withFailureHandler(() => { message.textContent = \\\"员工签到不可用。\\\"; })\\n          .getStaffTicketForCheckIn({ token: activeToken });\\n      });\\n\\n      checkInForm.addEventListener(\\\"submit\\\", (event) => {\\n        event.preventDefault();\\n        if (!checkInForm.elements.confirmCheckIn.checked) return;\\n        message.textContent = \\\"正在提交签到…\\\";\\n        google.script.run\\n          .withSuccessHandler((result) => {\\n            message.textContent = result && result.ok\\n              ? \\\"本场签到成功。\\\"\\n              : result && result.message ? result.message : \\\"签到未完成。\\\";\\n          })\\n          .withFailureHandler(() => { message.textContent = \\\"员工签到不可用。\\\"; })\\n          .checkIn({ token: activeToken, sessionId: checkInForm.elements.sessionId.value });\\n      });\\n    </script>\\n  </body>\\n</html>\\n\\n===== staff-apps-script/Admin.html =====\\n<!doctype html>\\n<html lang=\\\"zh-CN\\\">\\n  <head>\\n    <base target=\\\"_top\\\">\\n    <meta charset=\\\"utf-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n    <style>\\n      :root {\\n        --charcoal: #18131d;\\n        --panel: #261d2b;\\n        --panel-deep: #100d13;\\n        --ivory: #f8f0df;\\n        --muted: #c8b9ca;\\n        --line: #594463;\\n        --magenta: #ff4fa3;\\n        --purple: #8755ff;\\n        --green: #77e4aa;\\n        --danger: #ff7f91;\\n        --radius: 18px;\\n      }\\n      * { box-sizing: border-box; }\\n      html { scroll-behavior: smooth; }\\n      body {\\n        margin: 0;\\n        background:\\n          radial-gradient(circle at 84% 8%, rgba(135, 85, 255, .16), transparent 28rem),\\n          var(--charcoal);\\n        color: var(--ivory);\\n        font: 15px/1.5 \\\"Aptos\\\", \\\"Noto Sans SC\\\", \\\"Microsoft YaHei\\\", sans-serif;\\n      }\\n      button, input, select, textarea { font: inherit; }\\n      button, a, input, select, textarea { outline: none; }\\n      :focus-visible { box-shadow: 0 0 0 3px var(--charcoal), 0 0 0 6px var(--magenta); }\\n      .shell { min-height: 100vh; display: grid; grid-template-columns: 250px minmax(0, 1fr); }\\n      .sidebar {\\n        position: sticky; top: 0; height: 100vh; padding: 28px 22px;\\n        border-right: 1px solid var(--line); background: rgba(16, 13, 19, .9);\\n        backdrop-filter: blur(18px);\\n      }\\n      .eyebrow { margin: 0; color: var(--magenta); font: 700 11px/1.2 \\\"Consolas\\\", monospace; letter-spacing: .16em; text-transform: uppercase; }\\n      .brand { margin: 8px 0 6px; font: 700 29px/1.05 \\\"Iowan Old Style\\\", \\\"Noto Serif SC\\\", Georgia, serif; }\\n      .sidebar-copy { margin: 0 0 24px; color: var(--muted); font-size: 13px; }\\n      nav { display: grid; gap: 7px; }\\n      nav a { padding: 9px 11px; border-left: 2px solid transparent; color: var(--muted); text-decoration: none; }\\n      nav a:hover { color: var(--ivory); border-color: var(--magenta); background: rgba(255, 79, 163, .07); }\\n      .workspace { min-width: 0; padding: 34px clamp(18px, 4vw, 54px) 64px; }\\n      .masthead { display: grid; gap: 22px; margin: 0 auto 28px; max-width: 1420px; }\\n      .masthead h1 { max-width: 850px; margin: 4px 0 0; font: 650 clamp(34px, 5vw, 68px)/.98 \\\"Iowan Old Style\\\", \\\"Noto Serif SC\\\", Georgia, serif; letter-spacing: -.035em; }\\n      .masthead p { max-width: 760px; margin: 0; color: var(--muted); }\\n      .lifecycle-rail {\\n        display: grid; grid-template-columns: repeat(8, minmax(92px, 1fr)); overflow: auto;\\n        border: 1px solid var(--line); border-radius: 999px; background: var(--panel-deep);\\n      }\\n      .lifecycle-rail span { position: relative; padding: 10px 15px; color: var(--muted); font: 700 11px/1 \\\"Consolas\\\", monospace; text-align: center; text-transform: uppercase; }\\n      .lifecycle-rail span + span::before { content: \\\"\\\"; position: absolute; inset: 7px auto 7px 0; width: 1px; background: var(--line); }\\n      .lifecycle-rail [data-public=\\\"true\\\"] { color: var(--ivory); }\\n      .lifecycle-rail [data-live=\\\"true\\\"] { color: var(--green); }\\n      .status-line { min-height: 28px; margin: 0 auto 14px; max-width: 1420px; color: var(--green); }\\n      .stack { display: grid; gap: 22px; max-width: 1420px; margin: auto; }\\n      .panel { scroll-margin-top: 18px; border: 1px solid var(--line); border-radius: var(--radius); background: rgba(38, 29, 43, .96); box-shadow: 0 20px 70px rgba(0, 0, 0, .18); }\\n      .panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; padding: 20px 22px; border-bottom: 1px solid var(--line); }\\n      .panel-head h2 { margin: 2px 0 0; font: 650 25px/1.1 \\\"Iowan Old Style\\\", \\\"Noto Serif SC\\\", Georgia, serif; }\\n      .panel-head p { max-width: 640px; margin: 4px 0 0; color: var(--muted); font-size: 13px; }\\n      .panel-body { display: grid; gap: 18px; padding: 22px; }\\n      .split { display: grid; grid-template-columns: minmax(320px, .85fr) minmax(420px, 1.15fr); gap: 18px; }\\n      form, .form-grid { display: grid; gap: 13px; }\\n      .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\\n      .wide { grid-column: 1 / -1; }\\n      label { display: grid; align-content: start; gap: 6px; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: .025em; }\\n      input, select, textarea {\\n        width: 100%; min-height: 42px; padding: 9px 11px; border: 1px solid #6b5874;\\n        border-radius: 10px; background: #171219; color: var(--ivory);\\n      }\\n      textarea { min-height: 86px; resize: vertical; }\\n      .checks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 14px; }\\n      .check { display: flex; align-items: flex-start; gap: 8px; color: var(--ivory); font-weight: 500; }\\n      .check input { width: auto; min-height: auto; margin: 4px 0 0; accent-color: var(--magenta); }\\n      .actions { display: flex; flex-wrap: wrap; gap: 9px; }\\n      button {\\n        min-height: 42px; padding: 9px 14px; border: 1px solid transparent; border-radius: 10px;\\n        background: linear-gradient(115deg, var(--magenta), var(--purple)); color: white; font-weight: 800; cursor: pointer;\\n      }\\n      button.secondary { border-color: var(--line); background: transparent; color: var(--ivory); }\\n      button.danger { border-color: rgba(255, 127, 145, .55); background: rgba(255, 127, 145, .1); color: #ffd5dc; }\\n      button:disabled { opacity: .45; cursor: not-allowed; }\\n      .data-list { display: grid; gap: 9px; align-content: start; max-height: 540px; overflow: auto; }\\n      .data-row { display: grid; gap: 6px; padding: 13px 14px; border: 1px solid rgba(89, 68, 99, .8); border-radius: 12px; background: rgba(16, 13, 19, .48); }\\n      .data-row strong { color: var(--ivory); }\\n      .data-row small, .empty { color: var(--muted); }\\n      .pill { display: inline-flex; width: fit-content; padding: 3px 8px; border: 1px solid var(--line); border-radius: 999px; color: var(--green); font: 700 10px/1.3 \\\"Consolas\\\", monospace; text-transform: uppercase; }\\n      .warning { margin: 0; padding: 13px 15px; border-left: 3px solid var(--magenta); background: rgba(255, 79, 163, .07); color: var(--ivory); }\\n      .source-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }\\n      .source-card { display: grid; gap: 12px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel-deep); }\\n      .source-card h3 { margin: 0; }\\n      code { color: #e6d9ff; font-family: \\\"Consolas\\\", monospace; }\\n      [hidden] { display: none !important; }\\n      @media (max-width: 1050px) {\\n        .shell { grid-template-columns: 1fr; }\\n        .sidebar { z-index: 4; height: auto; padding: 14px 18px; border: 0; border-bottom: 1px solid var(--line); }\\n        .sidebar .brand, .sidebar-copy { display: none; }\\n        nav { display: flex; gap: 2px; overflow: auto; }\\n        nav a { flex: 0 0 auto; border-left: 0; border-bottom: 2px solid transparent; }\\n        .split { grid-template-columns: 1fr; }\\n      }\\n      @media (max-width: 680px) {\\n        .workspace { padding-inline: 13px; }\\n        .fields, .checks, .source-grid { grid-template-columns: 1fr; }\\n        .panel-head, .panel-body { padding-inline: 15px; }\\n        .masthead h1 { font-size: 38px; }\\n      }\\n      @media (prefers-reduced-motion: reduce) {\\n        html { scroll-behavior: auto; }\\n        *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }\\n      }\\n    </style>\\n  </head>\\n  <body>\\n    <div class=\\\"shell\\\">\\n      <aside class=\\\"sidebar\\\">\\n        <p class=\\\"eyebrow\\\">Protected staff project</p>\\n        <p class=\\\"brand\\\">Event control room</p>\\n        <p class=\\\"sidebar-copy\\\">管理活动、场次、座位、问题与历史记录。身份来自当前 Google 登录会话。</p>\\n        <nav aria-label=\\\"管理区导航\\\">\\n          <a href=\\\"#events\\\">活动</a><a href=\\\"#sessions\\\">场次</a><a href=\\\"#seats\\\">座位</a>\\n          <a href=\\\"#questions\\\">问题</a><a href=\\\"#records\\\">记录</a><a href=\\\"#attendance\\\">签到</a>\\n          <a href=\\\"#sheet-settings\\\">数据表</a><a href=\\\"#source-bundles\\\">部署源码</a>\\n        </nav>\\n      </aside>\\n\\n      <main class=\\\"workspace\\\">\\n        <header class=\\\"masthead\\\">\\n          <p class=\\\"eyebrow\\\">Administrator application</p>\\n          <h1>从草稿到归档，保持每一条历史记录可追溯。</h1>\\n          <p>关闭活动默认设为已结束。归档只隐藏公开显示，不删除活动、报名、座位或签到记录。</p>\\n          <div class=\\\"lifecycle-rail\\\" aria-label=\\\"活动生命周期\\\">\\n            <span>draft</span><span data-public=\\\"true\\\">upcoming</span><span data-public=\\\"true\\\">open</span>\\n            <span data-public=\\\"true\\\">closed</span><span data-live=\\\"true\\\">live</span>\\n            <span data-public=\\\"true\\\">ended</span><span data-public=\\\"true\\\">cancelled</span><span>archived</span>\\n          </div>\\n        </header>\\n        <p id=\\\"admin-status\\\" class=\\\"status-line\\\" role=\\\"status\\\" aria-live=\\\"polite\\\">正在读取管理数据…</p>\\n\\n        <div class=\\\"stack\\\">\\n          <section id=\\\"events\\\" class=\\\"panel\\\">\\n            <div class=\\\"panel-head\\\"><div><p class=\\\"eyebrow\\\">Lifecycle</p><h2>活动</h2><p>设定状态、开放时间、倒数显示、场次选择与取消／换座政策。</p></div></div>\\n            <div class=\\\"panel-body split\\\">\\n              <form id=\\\"event-form\\\">\\n                <input name=\\\"eventId\\\" type=\\\"hidden\\\">\\n                <div class=\\\"fields\\\">\\n                  <label class=\\\"wide\\\">活动名称<input name=\\\"title\\\" required maxlength=\\\"200\\\"></label>\\n                  <label class=\\\"wide\\\">说明<textarea name=\\\"description\\\" maxlength=\\\"5000\\\"></textarea></label>\\n                  <label>状态<select name=\\\"status\\\">\\n                    <option value=\\\"draft\\\">草稿 draft</option><option value=\\\"upcoming\\\">即将开放 upcoming</option>\\n                    <option value=\\\"open\\\">报名开放 open</option><option value=\\\"closed\\\">报名关闭 closed</option>\\n                    <option value=\\\"live\\\">进行中 live</option><option value=\\\"ended\\\">已结束 ended</option>\\n                    <option value=\\\"cancelled\\\">已取消 cancelled</option><option value=\\\"archived\\\">已归档 archived</option>\\n                  </select></label>\\n                  <label>地点<input name=\\\"location\\\" maxlength=\\\"300\\\"></label>\\n                  <label>开放时间<input name=\\\"opensAt\\\" type=\\\"datetime-local\\\"></label>\\n                  <label>截止时间<input name=\\\"closesAt\\\" type=\\\"datetime-local\\\"></label>\\n                  <label>场次选择规则<select name=\\\"selectionMode\\\">\\n                    <option value=\\\"none\\\">无需选择</option><option value=\\\"single\\\">单选</option><option value=\\\"all\\\">全部</option>\\n                    <option value=\\\"free\\\">自由多选</option><option value=\\\"mixed\\\">必选＋自选</option><option value=\\\"multiple\\\">多选</option>\\n                  </select></label>\\n                  <label>座位模式<select name=\\\"seatMode\\\">\\n                    <option value=\\\"none\\\">none 自由入座</option><option value=\\\"self\\\">self 自行选座</option>\\n                    <option value=\\\"auto\\\">auto 系统分配</option><option value=\\\"zone\\\">zone 选择区域</option>\\n                  </select></label>\\n                  <label>最少场次<input name=\\\"minChoices\\\" type=\\\"number\\\" min=\\\"0\\\" step=\\\"1\\\" value=\\\"0\\\"></label>\\n                  <label>最多场次<input name=\\\"maxChoices\\\" type=\\\"number\\\" min=\\\"0\\\" step=\\\"1\\\" value=\\\"0\\\"></label>\\n                  <label class=\\\"wide\\\">座位区域（每行一个）<textarea name=\\\"seatZones\\\"></textarea></label>\\n                </div>\\n                <div class=\\\"checks\\\">\\n                  <label class=\\\"check\\\"><input name=\\\"showOpeningCountdown\\\" type=\\\"checkbox\\\">显示开放倒数</label>\\n                  <label class=\\\"check\\\"><input name=\\\"showClosingCountdown\\\" type=\\\"checkbox\\\">显示截止倒数</label>\\n                  <label class=\\\"check\\\"><input name=\\\"cancellationEnabled\\\" type=\\\"checkbox\\\">允许参加者取消</label>\\n                  <label class=\\\"check\\\"><input name=\\\"seatExchangeEnabled\\\" type=\\\"checkbox\\\">允许参加者换座</label>\\n                </div>\\n                <div class=\\\"actions\\\">\\n                  <button type=\\\"submit\\\">保存活动</button>\\n                  <button class=\\\"secondary\\\" type=\\\"button\\\" data-action=\\\"close\\\">关闭为已结束</button>\\n                  <button class=\\\"secondary\\\" type=\\\"button\\\" data-action=\\\"reopen\\\">重新开放</button>\\n                  <button class=\\\"danger\\\" type=\\\"button\\\" data-action=\\\"archive\\\">归档</button>\\n                </div>\\n                <p class=\\\"warning\\\">重新开放前会显示现有报名人数，并要求明确确认。</p>\\n              </form>\\n              <div id=\\\"event-list\\\" class=\\\"data-list\\\" aria-label=\\\"活动列表\\\"></div>\\n            </div>\\n          </section>\\n\\n          <section id=\\\"sessions\\\" class=\\\"panel\\\">\\n            <div class=\\\"panel-head\\\"><div><p class=\\\"eyebrow\\\">Programme</p><h2>场次</h2><p>编辑讲题、讲师、时间、地点、容量、必选和分组规则。</p></div></div>\\n            <div class=\\\"panel-body split\\\">\\n              <form id=\\\"session-form\\\">\\n                <input name=\\\"sessionId\\\" type=\\\"hidden\\\">\\n                <div class=\\\"fields\\\">\\n                  <label>所属活动 ID<input name=\\\"eventId\\\" required></label>\\n                  <label>场次状态<select name=\\\"status\\\">\\n                    <option value=\\\"draft\\\">draft</option><option value=\\\"upcoming\\\">upcoming</option><option value=\\\"open\\\">open</option>\\n                    <option value=\\\"closed\\\">closed</option><option value=\\\"live\\\">live</option><option value=\\\"ended\\\">ended</option>\\n                    <option value=\\\"cancelled\\\">cancelled</option><option value=\\\"archived\\\">archived</option>\\n                  </select></label>\\n                  <label class=\\\"wide\\\">标题<input name=\\\"title\\\" required></label>\\n                  <label>讲师<input name=\\\"speaker\\\"></label><label>地点<input name=\\\"location\\\"></label>\\n                  <label>开始时间<input name=\\\"startsAt\\\" type=\\\"datetime-local\\\"></label>\\n                  <label>结束时间<input name=\\\"endsAt\\\" type=\\\"datetime-local\\\"></label>\\n                  <label>容量<input name=\\\"capacity\\\" type=\\\"number\\\" min=\\\"0\\\" step=\\\"1\\\" value=\\\"0\\\"></label>\\n                  <label>分组规则<input name=\\\"groupRule\\\"></label>\\n                </div>\\n                <label class=\\\"check\\\"><input name=\\\"required\\\" type=\\\"checkbox\\\">这是必选场次</label>\\n                <button type=\\\"submit\\\">保存场次</button>\\n              </form>\\n              <div id=\\\"session-list\\\" class=\\\"data-list\\\" aria-label=\\\"场次列表\\\"></div>\\n            </div>\\n          </section>\\n\\n          <section id=\\\"seats\\\" class=\\\"panel\\\">\\n            <div class=\\\"panel-head\\\"><div><p class=\\\"eyebrow\\\">Floor plan</p><h2>座位</h2><p>按活动／场次生成座位；已有座位只会保留或改变状态。</p></div></div>\\n            <div class=\\\"panel-body split\\\">\\n              <form id=\\\"seat-form\\\">\\n                <div class=\\\"fields\\\">\\n                  <label>活动 ID<input name=\\\"eventId\\\" required></label><label>场次 ID<input name=\\\"sessionId\\\"></label>\\n                  <label>模式<select name=\\\"mode\\\">\\n                    <option value=\\\"none\\\">none 自由入座</option><option value=\\\"self\\\">self 自行选座</option>\\n                    <option value=\\\"auto\\\">auto 系统分配</option><option value=\\\"zone\\\">zone 区域选择</option>\\n                  </select></label>\\n                  <label>区域名称<input name=\\\"zoneName\\\"></label>\\n                  <label>行数<input name=\\\"rows\\\" type=\\\"number\\\" min=\\\"0\\\" step=\\\"1\\\" value=\\\"1\\\"></label>\\n                  <label>每行座位<input name=\\\"seatsPerRow\\\" type=\\\"number\\\" min=\\\"0\\\" step=\\\"1\\\" value=\\\"1\\\"></label>\\n                </div>\\n                <button type=\\\"submit\\\">生成／更新座位方案</button>\\n                <p class=\\\"warning\\\">保留、关闭与重新开放只改变座位状态，不会删除座位行。</p>\\n              </form>\\n              <div id=\\\"seat-list\\\" class=\\\"data-list\\\" aria-label=\\\"座位列表\\\"></div>\\n            </div>\\n          </section>\\n\\n          <section id=\\\"questions\\\" class=\\\"panel\\\">\\n            <div class=\\\"panel-head\\\"><div><p class=\\\"eyebrow\\\">Registration form</p><h2>报名问题</h2><p>支持排序、显示／隐藏、必填、选项、验证、票面显示和重复身份判断。</p></div></div>\\n            <div class=\\\"panel-body split\\\">\\n              <form id=\\\"question-form\\\">\\n                <input name=\\\"questionId\\\" type=\\\"hidden\\\">\\n                <div class=\\\"fields\\\">\\n                  <label>活动 ID<input name=\\\"eventId\\\" required></label>\\n                  <label>字段类型<select name=\\\"type\\\">\\n                    <option value=\\\"text\\\">text</option><option value=\\\"textarea\\\">textarea</option><option value=\\\"number\\\">number</option>\\n                    <option value=\\\"tel\\\">tel</option><option value=\\\"email\\\">email</option><option value=\\\"date\\\">date</option>\\n                    <option value=\\\"radio\\\">radio</option><option value=\\\"checkbox\\\">checkbox</option><option value=\\\"select\\\">select</option>\\n                    <option value=\\\"boolean\\\">boolean</option>\\n                  </select></label>\\n                  <label class=\\\"wide\\\">问题文字<input name=\\\"label\\\" required></label>\\n                  <label class=\\\"wide\\\">选项（每行一个）<textarea name=\\\"options\\\"></textarea></label>\\n                  <label class=\\\"wide\\\">验证规则（JSON，例如 {\\\"minLength\\\":2}）<textarea name=\\\"validation\\\">{}</textarea></label>\\n                  <label>排序<input name=\\\"sortOrder\\\" type=\\\"number\\\" min=\\\"0\\\" step=\\\"1\\\" value=\\\"0\\\"></label>\\n                  <label>显示状态<select name=\\\"status\\\"><option value=\\\"active\\\">显示</option><option value=\\\"inactive\\\">隐藏</option></select></label>\\n                </div>\\n                <div class=\\\"checks\\\">\\n                  <label class=\\\"check\\\"><input name=\\\"required\\\" type=\\\"checkbox\\\">必填</label>\\n                  <label class=\\\"check\\\"><input name=\\\"showOnTicket\\\" type=\\\"checkbox\\\">显示在电子票</label>\\n                  <label class=\\\"check\\\"><input name=\\\"duplicateIdentity\\\" type=\\\"checkbox\\\">用于重复身份判断</label>\\n                </div>\\n                <button type=\\\"submit\\\">保存问题</button>\\n              </form>\\n              <div id=\\\"question-list\\\" class=\\\"data-list\\\" aria-label=\\\"报名问题列表\\\"></div>\\n            </div>\\n          </section>\\n\\n          <section id=\\\"records\\\" class=\\\"panel\\\">\\n            <div class=\\\"panel-head\\\"><div><p class=\\\"eyebrow\\\">History</p><h2>报名记录</h2><p>列表与搜索只显示脱敏资料；取消和调整座位保留全部历史。</p></div></div>\\n            <div class=\\\"panel-body\\\">\\n              <form id=\\\"record-search-form\\\" class=\\\"actions\\\">\\n                <label>搜索报名号／票号／姓名／联系方式<input name=\\\"search\\\"></label>\\n                <button type=\\\"submit\\\">搜索</button><button class=\\\"secondary\\\" type=\\\"button\\\" id=\\\"clear-search\\\">清除</button>\\n              </form>\\n              <form id=\\\"record-action-form\\\">\\n                <div class=\\\"fields\\\">\\n                  <label>报名 ID<input name=\\\"registrationId\\\" required></label>\\n                  <label>新座位 ID<input name=\\\"seatId\\\"></label>\\n                </div>\\n                <div class=\\\"actions\\\">\\n                  <button class=\\\"danger\\\" type=\\\"button\\\" data-action=\\\"cancel_registration\\\">确认取消报名</button>\\n                  <button class=\\\"secondary\\\" type=\\\"button\\\" data-action=\\\"adjust_seat\\\">确认调整座位</button>\\n                </div>\\n              </form>\\n              <div id=\\\"record-list\\\" class=\\\"data-list\\\" aria-label=\\\"脱敏报名记录\\\"></div>\\n            </div>\\n          </section>\\n\\n          <section id=\\\"attendance\\\" class=\\\"panel\\\">\\n            <div class=\\\"panel-head\\\"><div><p class=\\\"eyebrow\\\">Door log</p><h2>签到记录</h2><p>按场次查看服务器时间签到历史。</p></div></div>\\n            <div class=\\\"panel-body\\\"><div id=\\\"attendance-list\\\" class=\\\"data-list\\\" aria-label=\\\"签到记录\\\"></div></div>\\n          </section>\\n\\n          <section id=\\\"sheet-settings\\\" class=\\\"panel\\\">\\n            <div class=\\\"panel-head\\\"><div><p class=\\\"eyebrow\\\">Connection</p><h2>数据表连接</h2><p id=\\\"connection-status\\\">尚未读取连接状态。</p></div></div>\\n            <div class=\\\"panel-body\\\">\\n              <form id=\\\"sheet-form\\\">\\n                <label>目标 Google Sheet ID<input name=\\\"spreadsheetId\\\" type=\\\"password\\\" autocomplete=\\\"off\\\" required></label>\\n                <div class=\\\"actions\\\"><button type=\\\"button\\\" id=\\\"test-sheet\\\">测试连接</button><button class=\\\"danger\\\" type=\\\"button\\\" id=\\\"switch-sheet\\\">确认切换数据表</button></div>\\n              </form>\\n              <p class=\\\"warning\\\">切换是非破坏性的：旧数据仍保留在原数据表中，系统不会自动迁移任何数据。</p>\\n            </div>\\n          </section>\\n\\n          <section id=\\\"source-bundles\\\" class=\\\"panel\\\">\\n            <div class=\\\"panel-head\\\"><div><p class=\\\"eyebrow\\\">Two deployments</p><h2>Apps Script 部署源码</h2><p>分别建立公开后端项目与员工／管理员项目；不可合并为同一个部署。</p></div></div>\\n            <div class=\\\"panel-body\\\">\\n              <div class=\\\"source-grid\\\">\\n                <article class=\\\"source-card\\\"><h3>公开后端</h3><p>部署为执行者本人，允许匿名访问。只把此项目的 <code>/exec</code> URL 放进公开网页设置。</p><button type=\\\"button\\\" data-copy-bundle=\\\"publicBackend\\\">复制公开后端源码</button></article>\\n                <article class=\\\"source-card\\\"><h3>员工／管理员</h3><p>部署为访问者本人，必须 Google 登录，并配置独立员工与管理员许可名单。</p><button type=\\\"button\\\" data-copy-bundle=\\\"staffAdmin\\\">复制员工／管理员源码</button></article>\\n              </div>\\n              <p class=\\\"warning\\\">源码包不会包含密码、许可名单值、当前数据表 ID、参加者资料或私人答案。</p>\\n            </div>\\n          </section>\\n        </div>\\n      </main>\\n    </div>\\n    <?!= HtmlService.createHtmlOutputFromFile('AdminScript').getContent(); ?>\\n  </body>\\n</html>\\n\\n===== staff-apps-script/AdminScript.html =====\\n<script>\\n  (() => {\\n    \\\"use strict\\\";\\n\\n    const state = { dashboard: null, bundles: null };\\n    const statusNode = document.querySelector(\\\"#admin-status\\\");\\n\\n    function setStatus(message, kind = \\\"success\\\") {\\n      statusNode.textContent = message;\\n      statusNode.style.color = kind === \\\"error\\\" ? \\\"var(--danger)\\\" : \\\"var(--green)\\\";\\n    }\\n\\n    function adminRunner_(success) {\\n      return google.script.run\\n        .withSuccessHandler((result) => {\\n          if (!result || result.ok !== true) {\\n            setStatus(result && result.message ? result.message : \\\"管理员功能不可用。\\\", \\\"error\\\");\\n            return;\\n          }\\n          success(result.data);\\n        })\\n        .withFailureHandler(() => setStatus(\\\"管理员功能不可用。\\\", \\\"error\\\"));\\n    }\\n\\n    function element(tag, text, className) {\\n      const node = document.createElement(tag);\\n      if (text !== undefined && text !== null) node.textContent = String(text);\\n      if (className) node.className = className;\\n      return node;\\n    }\\n\\n    function replaceList(selector, items, render) {\\n      const container = document.querySelector(selector);\\n      container.replaceChildren();\\n      if (!items || items.length === 0) {\\n        container.append(element(\\\"p\\\", \\\"暂无记录。\\\", \\\"empty\\\"));\\n        return;\\n      }\\n      items.forEach((item) => container.append(render(item)));\\n    }\\n\\n    function dataRow(title, status, details) {\\n      const row = element(\\\"article\\\", null, \\\"data-row\\\");\\n      row.append(element(\\\"span\\\", status || \\\"record\\\", \\\"pill\\\"));\\n      row.append(element(\\\"strong\\\", title || \\\"未命名\\\"));\\n      (details || []).filter(Boolean).forEach((detail) => row.append(element(\\\"small\\\", detail)));\\n      return row;\\n    }\\n\\n    function editButton(label, handler) {\\n      const button = element(\\\"button\\\", label);\\n      button.type = \\\"button\\\";\\n      button.className = \\\"secondary\\\";\\n      button.addEventListener(\\\"click\\\", handler);\\n      return button;\\n    }\\n\\n    function renderDashboard(data) {\\n      state.dashboard = data;\\n      document.querySelector(\\\"#connection-status\\\").textContent = data.connection && data.connection.connected\\n        ? `已连接：${data.connection.sheetName || \\\"Google Sheet\\\"}`\\n        : \\\"未连接到数据表。\\\";\\n      replaceList(\\\"#event-list\\\", data.events, (item) => {\\n        const row = dataRow(item.title, item.status, [\\n          item.location, `${item.selectionMode} · ${item.seatMode}`,\\n          `场次选择 ${item.minChoices}–${item.maxChoices}`\\n        ]);\\n        row.append(editButton(\\\"编辑活动\\\", () => editAdminEvent(item)));\\n        return row;\\n      });\\n      replaceList(\\\"#session-list\\\", data.sessions, (item) => {\\n        const row = dataRow(item.title, item.status, [\\n          item.speaker, item.location, `${item.startsAt || \\\"未定\\\"} → ${item.endsAt || \\\"未定\\\"}`,\\n          `容量 ${item.capacity}${item.required ? \\\" · 必选\\\" : \\\"\\\"}${item.groupRule ? ` · ${item.groupRule}` : \\\"\\\"}`\\n        ]);\\n        row.append(editButton(\\\"编辑场次\\\", () => editAdminSession(item)));\\n        return row;\\n      });\\n      replaceList(\\\"#seat-list\\\", data.seats, (item) => {\\n        const row = dataRow(item.label, item.status, [item.zone, item.sessionId]);\\n        const actions = element(\\\"div\\\", null, \\\"actions\\\");\\n        [\\\"reserve\\\", \\\"close\\\", \\\"reopen\\\"].forEach((action) => {\\n          const button = element(\\\"button\\\", action === \\\"reserve\\\" ? \\\"保留\\\" : action === \\\"close\\\" ? \\\"关闭\\\" : \\\"重新开放\\\");\\n          button.type = \\\"button\\\";\\n          button.className = \\\"secondary\\\";\\n          button.dataset.action = action;\\n          button.addEventListener(\\\"click\\\", () => saveSeatAction(action, item.seatId));\\n          actions.append(button);\\n        });\\n        row.append(actions);\\n        return row;\\n      });\\n      replaceList(\\\"#question-list\\\", data.questions, (item) => {\\n        const row = dataRow(item.label, item.status, [\\n          `${item.type}${item.required ? \\\" · 必填\\\" : \\\"\\\"}`,\\n          `排序 ${item.sortOrder}${item.showOnTicket ? \\\" · 票面显示\\\" : \\\"\\\"}${item.duplicateIdentity ? \\\" · 身份判断\\\" : \\\"\\\"}`\\n        ]);\\n        row.append(editButton(\\\"编辑问题\\\", () => editAdminQuestion(item)));\\n        return row;\\n      });\\n      replaceList(\\\"#record-list\\\", data.records, (item) =>\\n        dataRow(`${item.ticketNumber} · ${item.participantName}`, item.status, [\\n          item.registrationId, item.email || item.phone,\\n          `场次 ${item.sessionIds.join(\\\", \\\") || \\\"无\\\"} · 座位 ${item.seatChoices.join(\\\", \\\") || \\\"无\\\"}`\\n        ]));\\n      replaceList(\\\"#attendance-list\\\", data.attendance, (item) =>\\n        dataRow(item.registrationId, item.status, [\\n          `场次 ${item.sessionId}`, item.checkedInAt, item.checkedInBy\\n        ]));\\n      setStatus(\\\"管理数据已更新。\\\");\\n    }\\n\\n    function loadDashboard(search = \\\"\\\") {\\n      setStatus(\\\"正在读取管理数据…\\\");\\n      adminRunner_(renderDashboard).getAdminDashboard({ search });\\n    }\\n\\n    function formObject(form) {\\n      return Object.fromEntries(new FormData(form).entries());\\n    }\\n\\n    function checked(form, name) {\\n      return form.elements[name].checked === true;\\n    }\\n\\n    function localDateValue(value) {\\n      return value ? new Date(value).toISOString() : \\\"\\\";\\n    }\\n\\n    function localDateInput(value) {\\n      if (!value) return \\\"\\\";\\n      const date = new Date(value);\\n      if (Number.isNaN(date.getTime())) return \\\"\\\";\\n      const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);\\n      return local.toISOString().slice(0, 16);\\n    }\\n\\n    function focusEditor(form) {\\n      form.scrollIntoView({ behavior: \\\"smooth\\\", block: \\\"center\\\" });\\n      const firstVisible = form.querySelector(\\\"input:not([type=hidden]), select, textarea\\\");\\n      if (firstVisible) firstVisible.focus();\\n    }\\n\\n    function editAdminEvent(item) {\\n      const form = document.querySelector(\\\"#event-form\\\");\\n      form.elements.eventId.value = item.eventId;\\n      form.elements.title.value = item.title;\\n      form.elements.description.value = item.description;\\n      form.elements.status.value = item.status;\\n      form.elements.opensAt.value = localDateInput(item.opensAt);\\n      form.elements.closesAt.value = localDateInput(item.closesAt);\\n      form.elements.location.value = item.location;\\n      form.elements.selectionMode.value = item.selectionMode;\\n      form.elements.minChoices.value = item.minChoices;\\n      form.elements.maxChoices.value = item.maxChoices;\\n      form.elements.seatMode.value = item.seatMode;\\n      form.elements.seatZones.value = (item.seatZones || []).join(\\\"\\\\n\\\");\\n      form.elements.showOpeningCountdown.checked = item.showOpeningCountdown === true;\\n      form.elements.showClosingCountdown.checked = item.showClosingCountdown === true;\\n      form.elements.cancellationEnabled.checked = item.cancellationEnabled === true;\\n      form.elements.seatExchangeEnabled.checked = item.seatExchangeEnabled === true;\\n      focusEditor(form);\\n    }\\n\\n    function editAdminSession(item) {\\n      const form = document.querySelector(\\\"#session-form\\\");\\n      form.elements.sessionId.value = item.sessionId;\\n      form.elements.eventId.value = item.eventId;\\n      form.elements.title.value = item.title;\\n      form.elements.speaker.value = item.speaker;\\n      form.elements.startsAt.value = localDateInput(item.startsAt);\\n      form.elements.endsAt.value = localDateInput(item.endsAt);\\n      form.elements.location.value = item.location;\\n      form.elements.capacity.value = item.capacity;\\n      form.elements.required.checked = item.required === true;\\n      form.elements.groupRule.value = item.groupRule;\\n      form.elements.status.value = item.status;\\n      focusEditor(form);\\n    }\\n\\n    function editAdminQuestion(item) {\\n      const form = document.querySelector(\\\"#question-form\\\");\\n      form.elements.questionId.value = item.questionId;\\n      form.elements.eventId.value = item.eventId;\\n      form.elements.label.value = item.label;\\n      form.elements.type.value = item.type;\\n      form.elements.options.value = (item.options || []).join(\\\"\\\\n\\\");\\n      form.elements.validation.value = JSON.stringify(item.validation || {}, null, 2);\\n      form.elements.sortOrder.value = item.sortOrder;\\n      form.elements.status.value = item.status;\\n      form.elements.required.checked = item.required === true;\\n      form.elements.showOnTicket.checked = item.showOnTicket === true;\\n      form.elements.duplicateIdentity.checked = item.duplicateIdentity === true;\\n      focusEditor(form);\\n    }\\n\\n    function eventPayload(action) {\\n      const form = document.querySelector(\\\"#event-form\\\");\\n      const values = formObject(form);\\n      return {\\n        ...values,\\n        eventId: values.eventId || undefined,\\n        action,\\n        opensAt: localDateValue(values.opensAt),\\n        closesAt: localDateValue(values.closesAt),\\n        minChoices: Number(values.minChoices),\\n        maxChoices: Number(values.maxChoices),\\n        seatZones: values.seatZones.split(/\\\\r?\\\\n/).map((value) => value.trim()).filter(Boolean),\\n        showOpeningCountdown: checked(form, \\\"showOpeningCountdown\\\"),\\n        showClosingCountdown: checked(form, \\\"showClosingCountdown\\\"),\\n        cancellationEnabled: checked(form, \\\"cancellationEnabled\\\"),\\n        seatExchangeEnabled: checked(form, \\\"seatExchangeEnabled\\\")\\n      };\\n    }\\n\\n    function saveEvent(action) {\\n      const payload = eventPayload(action);\\n      if (action === \\\"reopen\\\") {\\n        const count = state.dashboard && state.dashboard.records\\n          ? new Set(state.dashboard.records.filter((record) => record.eventId === payload.eventId)\\n            .map((record) => record.registrationId)).size : 0;\\n        if (!window.confirm(`此活动已有 ${count} 个报名。确认重新开放？`)) return;\\n        payload.confirm = true;\\n      }\\n      setStatus(\\\"正在保存活动…\\\");\\n      adminRunner_(() => loadDashboard()).saveAdminEvent(payload);\\n    }\\n\\n    document.querySelector(\\\"#event-form\\\").addEventListener(\\\"submit\\\", (event) => {\\n      event.preventDefault();\\n      saveEvent(\\\"\\\");\\n    });\\n    document.querySelectorAll(\\\"#event-form [data-action]\\\").forEach((button) => {\\n      button.addEventListener(\\\"click\\\", () => saveEvent(button.dataset.action));\\n    });\\n\\n    document.querySelector(\\\"#session-form\\\").addEventListener(\\\"submit\\\", (event) => {\\n      event.preventDefault();\\n      const form = event.currentTarget;\\n      const values = formObject(form);\\n      const payload = {\\n        ...values,\\n        sessionId: values.sessionId || undefined,\\n        startsAt: localDateValue(values.startsAt),\\n        endsAt: localDateValue(values.endsAt),\\n        capacity: Number(values.capacity),\\n        required: checked(form, \\\"required\\\")\\n      };\\n      setStatus(\\\"正在保存场次…\\\");\\n      adminRunner_(() => loadDashboard()).saveAdminSession(payload);\\n    });\\n\\n    document.querySelector(\\\"#seat-form\\\").addEventListener(\\\"submit\\\", (event) => {\\n      event.preventDefault();\\n      const values = formObject(event.currentTarget);\\n      const mode = values.mode;\\n      const payload = {\\n        eventId: values.eventId,\\n        sessionId: values.sessionId,\\n        action: \\\"generate\\\",\\n        mode,\\n        zones: mode === \\\"none\\\" ? [] : [{\\n          name: values.zoneName,\\n          rows: Number(values.rows),\\n          seatsPerRow: Number(values.seatsPerRow)\\n        }]\\n      };\\n      setStatus(\\\"正在保存座位方案…\\\");\\n      adminRunner_(() => loadDashboard()).saveAdminSeatPlan(payload);\\n    });\\n\\n    function saveSeatAction(action, seatId) {\\n      setStatus(\\\"正在更新座位…\\\");\\n      adminRunner_(() => loadDashboard()).saveAdminSeatPlan({ action, seatId });\\n    }\\n\\n    document.querySelector(\\\"#question-form\\\").addEventListener(\\\"submit\\\", (event) => {\\n      event.preventDefault();\\n      const form = event.currentTarget;\\n      const values = formObject(form);\\n      let validation;\\n      try {\\n        validation = JSON.parse(values.validation || \\\"{}\\\");\\n      } catch (_ignored) {\\n        setStatus(\\\"验证规则必须是有效 JSON。\\\", \\\"error\\\");\\n        return;\\n      }\\n      const payload = {\\n        ...values,\\n        questionId: values.questionId || undefined,\\n        options: values.options.split(/\\\\r?\\\\n/).map((value) => value.trim()).filter(Boolean),\\n        validation,\\n        sortOrder: Number(values.sortOrder),\\n        required: checked(form, \\\"required\\\"),\\n        showOnTicket: checked(form, \\\"showOnTicket\\\"),\\n        duplicateIdentity: checked(form, \\\"duplicateIdentity\\\")\\n      };\\n      setStatus(\\\"正在保存问题…\\\");\\n      adminRunner_(() => loadDashboard()).saveAdminQuestion(payload);\\n    });\\n\\n    document.querySelector(\\\"#record-search-form\\\").addEventListener(\\\"submit\\\", (event) => {\\n      event.preventDefault();\\n      loadDashboard(event.currentTarget.elements.search.value.trim());\\n    });\\n    document.querySelector(\\\"#clear-search\\\").addEventListener(\\\"click\\\", () => {\\n      document.querySelector(\\\"#record-search-form\\\").reset();\\n      loadDashboard();\\n    });\\n    document.querySelectorAll(\\\"#record-action-form [data-action]\\\").forEach((button) => {\\n      button.addEventListener(\\\"click\\\", () => {\\n        const form = document.querySelector(\\\"#record-action-form\\\");\\n        const values = formObject(form);\\n        if (!window.confirm(\\\"确认执行此操作并保留完整历史记录？\\\")) return;\\n        const payload = {\\n          action: button.dataset.action,\\n          registrationId: values.registrationId,\\n          seatId: values.seatId,\\n          confirm: true\\n        };\\n        setStatus(\\\"正在更新报名记录…\\\");\\n        adminRunner_(() => loadDashboard()).adminRecordAction(payload);\\n      });\\n    });\\n\\n    document.querySelector(\\\"#test-sheet\\\").addEventListener(\\\"click\\\", () => {\\n      const spreadsheetId = document.querySelector(\\\"#sheet-form\\\").elements.spreadsheetId.value.trim();\\n      setStatus(\\\"正在测试数据表连接…\\\");\\n      adminRunner_((data) => {\\n        document.querySelector(\\\"#connection-status\\\").textContent = `测试成功：${data.sheetName}`;\\n        setStatus(\\\"目标数据表连接正常。\\\");\\n      }).testAdminSheetConnection({ spreadsheetId });\\n    });\\n    document.querySelector(\\\"#switch-sheet\\\").addEventListener(\\\"click\\\", () => {\\n      const spreadsheetId = document.querySelector(\\\"#sheet-form\\\").elements.spreadsheetId.value.trim();\\n      if (!window.confirm(\\\"确认切换？旧数据会保留，系统不会自动迁移。\\\")) return;\\n      setStatus(\\\"正在验证公开后端的数据表权限…\\\");\\n      adminRunner_((data) => {\\n        const probeBody = JSON.stringify({\\n          action: \\\"probeSheetSwitch\\\",\\n          payload: { nonce: data.nonce }\\n        });\\n        fetch(data.probeUrl, {\\n          method: \\\"POST\\\",\\n          mode: \\\"no-cors\\\",\\n          headers: { \\\"Content-Type\\\": \\\"text/plain;charset=UTF-8\\\" },\\n          body: probeBody\\n        })\\n          .catch(() => null)\\n          .then(() => {\\n            setStatus(\\\"正在确认数据表切换…\\\");\\n            adminRunner_((completed) => {\\n              setStatus(completed.warning);\\n              document.querySelector(\\\"#sheet-form\\\").reset();\\n              loadDashboard();\\n            }).switchAdminSheet({ nonce: data.nonce, confirm: true });\\n          });\\n      }).switchAdminSheet({ spreadsheetId, confirm: true });\\n    });\\n\\n    function loadBundles(onReady) {\\n      if (state.bundles) {\\n        onReady(state.bundles);\\n        return;\\n      }\\n      setStatus(\\\"正在准备部署源码…\\\");\\n      adminRunner_((bundles) => {\\n        state.bundles = bundles;\\n        onReady(bundles);\\n      }).getAdminSourceBundles({});\\n    }\\n\\n    document.querySelectorAll(\\\"[data-copy-bundle]\\\").forEach((button) => {\\n      button.addEventListener(\\\"click\\\", () => {\\n        loadBundles((bundles) => {\\n          const key = button.dataset.copyBundle;\\n          const source = bundles && typeof bundles[key] === \\\"string\\\" ? bundles[key] : \\\"\\\";\\n          if (!source) {\\n            setStatus(\\\"源码包不可用。\\\", \\\"error\\\");\\n            return;\\n          }\\n          navigator.clipboard.writeText(source)\\n            .then(() => setStatus(\\\"源码已复制；请按文件分隔标记建立独立 Apps Script 项目。\\\"))\\n            .catch(() => setStatus(\\\"无法写入剪贴板，请检查浏览器权限。\\\", \\\"error\\\"));\\n        });\\n      });\\n    });\\n\\n    loadDashboard();\\n  })();\\n</script>\\n\";\n";
